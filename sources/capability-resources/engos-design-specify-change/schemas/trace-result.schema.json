{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceCheckResult.v1",
  "description": "Mechanical assessment only. No semantic, behavioral or authority approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mechanical_passed",
    "errors",
    "input_sha256",
    "schema_sha256",
    "semantic_correctness",
    "behavioral_verification",
    "authority_verification",
    "requirement_link_validation",
    "required_coverage",
    "tests_status",
    "test_link_validation",
    "test_execution",
    "design_link_validation",
    "design_artifact_verification",
    "source_binding",
    "graph_validation",
    "matrix",
    "uncovered_nonrequired_requirement_ids",
    "undecided_requirement_ids",
    "uncovered_test_inventory_ids",
    "skipped_design_link_count"
  ],
  "properties": {
    "schema_version": {
      "const": "TraceCheckResult.v1"
    },
    "mechanical_passed": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "artifact",
          "pointer",
          "ids",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "artifact": {
            "enum": [
              "plan",
              "spec",
              "tests",
              "package",
              "cli"
            ]
          },
          "pointer": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "spec": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tests": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "schema_sha256": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec-contract.schema.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task-plan.schema.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task-contract.schema.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "test-design.schema.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "semantic_correctness": {
      "const": "not_assessed"
    },
    "behavioral_verification": {
      "const": "not_assessed"
    },
    "authority_verification": {
      "const": "not_assessed"
    },
    "requirement_link_validation": {
      "enum": [
        "passed",
        "failed",
        "not_assessed"
      ]
    },
    "required_coverage": {
      "enum": [
        "passed",
        "failed",
        "not_assessed"
      ]
    },
    "tests_status": {
      "enum": [
        "supplied",
        "not_supplied"
      ]
    },
    "test_link_validation": {
      "enum": [
        "passed",
        "failed",
        "not_supplied",
        "not_assessed"
      ]
    },
    "test_execution": {
      "enum": [
        "not_run",
        "not_supplied"
      ]
    },
    "design_link_validation": {
      "enum": [
        "passed",
        "failed",
        "not_selected",
        "not_assessed"
      ]
    },
    "design_artifact_verification": {
      "const": "not_assessed"
    },
    "source_binding": {
      "enum": [
        "matched",
        "not_supplied",
        "mismatch",
        "not_assessed"
      ]
    },
    "graph_validation": {
      "const": "not_assessed"
    },
    "matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "priority",
          "required",
          "task_ids",
          "test_ids",
          "design_ids"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could",
              "undecided"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "design_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "uncovered_nonrequired_requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "undecided_requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncovered_test_inventory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped_design_link_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
