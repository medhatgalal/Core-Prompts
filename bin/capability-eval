#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
if [[ -n "${PYTHON_BIN:-}" ]]; then
  PYTHON="$PYTHON_BIN"
elif command -v python3.14 >/dev/null 2>&1; then
  PYTHON=python3.14
else
  PYTHON=python3
fi
exec "$PYTHON" -m core_prompts_eval.cli --repo-root "$ROOT" "$@"
