{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskPlan.v1",
  "description": "Optional projection of the authoritative plan and existing tracker. No automatic approval, property-level unique task IDs, dependency/cycle validation, completed-ID membership, coverage, source truth, authority or execution checks. Null hashes identify unavailable byte binding; do not invent digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "spec_ref",
    "spec_sha256",
    "tasks",
    "completed_task_ids",
    "tracker_ref",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "TaskPlan.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "spec_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "spec_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "task-contract.schema.json"
      }
    },
    "completed_task_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "tracker_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  }
}
