{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskContract.v1",
  "description": "Optional task interchange shape. Validation does not establish source truth, digest correctness, independent task quality, authority, acceptance, reference existence, graph validity or execution. Null digests/authority require explicit unresolved context in the plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "outcome",
    "requirement_ids",
    "design_ids",
    "depends_on",
    "consumes",
    "produces",
    "likely_files",
    "allowed_writes",
    "constraints",
    "verification",
    "stop_condition",
    "authority_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "TaskContract.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "design_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "consumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "produces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "likely_files": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "allowed_writes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "oracle",
          "command_or_inspection"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "oracle": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "command_or_inspection": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "stop_condition": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
