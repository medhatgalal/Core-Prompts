    "G2": {
      "predicates": ["uncertainties_resolved", "evidence_sufficiency", "grounded_risks"],
      "required_outputs": ["research-notes.md"]
    },
    "G3": {
      "predicates": ["coherent_bounded_solution", "exemplar_coverage", "diagrams_visual", "contracts_security", "workstreams_proof", "constraints_traceability", "author_audit", "independent_review", "rubric_assessment"],
      "required_outputs": ["pitch.md", "pitch-summary.md", "workstreams.md", "traceability.md", "contracts.md", "security-owners.md", "component.mmd", "sequence.mmd", "data-flow.mmd"]
