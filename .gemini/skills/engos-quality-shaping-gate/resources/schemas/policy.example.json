    "G0": {
      "predicates": ["original_preserved", "source_coverage", "fact_classification", "no_selected_solution"],
      "required_outputs": ["brief.md", "intake.md"]
    },
    "G1": {
      "predicates": ["problem_frame", "confirmed_appetite_walkaway", "boundaries_uncertainties", "no_selected_solution"],
      "required_outputs": ["framed.md"]
