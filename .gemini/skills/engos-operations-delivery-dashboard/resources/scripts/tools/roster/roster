#!/usr/bin/env python3
"""roster: manage data/roster.csv (source of truth), per skill-spec.md.

Reads:  list, show, diff, history, export          (all take --json where they print data)
Writes: add, remove, set-team, set-group, set-manager, set-title, set-note, set-identity,
        ignore, unignore, import, sync --apply-lines
Every write: --reason is required; --dry-run prints the PLAN and writes nothing; otherwise the PLAN is shown and
the write happens only after you type "apply" (or pass --apply, meaning you already saw the PLAN).
Every applied write appends one line to the ledger (data/ledger.csv): when, actor, command, person, field, before,
after, reason. Removal sets end_date and keeps history. A person with no group or team is fine.
Environment: ROSTER_DATA_DIR (use a copy of data/ for tests), ROSTER_ACTOR (default: owner account from config),
DASHBOARD_AGENT (your role; the ledger line reads "<account> via <role>"; a write without it is refused unless --as-user, which records "via user").
"""
import sys, os, json, argparse, collections, subprocess, pathlib
sys.path.insert(0, str(pathlib.Path(__file__).parent))
from common import *

def actor():
    return ledger_actor()

def load():
    rows = read_csv(ROSTER)
    if not rows: sys.exit(f"roster: no roster at {ROSTER}; seed it first")
    return rows

def find(rows, q, strict=True):
    k = norm(q)
    hit = [r for r in rows if norm(r["name"]) == k or norm(r["chart_name"]) == k]
    if not hit and not strict: hit = [r for r in rows if k in norm(r["name"]) or k in norm(r["chart_name"])]
    if not hit: sys.exit(f"roster: no person matches {q!r}")
    if len(hit) > 1: sys.exit(f"roster: {q!r} is ambiguous: {', '.join(r['name'] for r in hit)}")
    return hit[0]

def emit(rows, cols, args, title=None):
    if args.json: print(json.dumps(rows, indent=1, ensure_ascii=False)); return
    if title: print(title)
    w = {c: max(len(c), *(len(str(r.get(c, ""))) for r in rows)) if rows else len(c) for c in cols}
    print("  ".join(c.ljust(w[c]) for c in cols))
    for r in rows: print("  ".join(str(r.get(c, "")).ljust(w[c]) for c in cols))
    print(f"({len(rows)} rows)")

def confirm(plan, args):
    """plan: list of (person, field, before, after). Shows PLAN; returns True when the write should happen."""
    print(f"PLAN ({args.cmd}) reason: {args.reason}")
    for p, f, b, a in plan: print(f"  {p}: {f}: {b!r} -> {a!r}")
    print(f"  roster file: {ROSTER}; ledger lines to add: {len(plan)}; the Sheet's Roster tab is regenerated by `refresh`")
    if args.dry_run: print("dry-run: nothing written"); return False
    if args.apply: ledger_actor(); return True
    if not sys.stdin.isatty(): print('not applied: pass --apply (or run interactively and type "apply")'); return False
    ok = input('type "apply" to write: ').strip().lower() == "apply"
    if ok: ledger_actor()
    return ok

def write_with_ledger(rows, plan, args, cmd=None):
    write_csv(ROSTER, rows, ROSTER_COLS)
    for p, f, b, a in plan:
        ledger_append(cmd or args.cmd, p, f, b, a, ("[scratch] " if args.scratch else "") + args.reason)
    print(f"applied: {len(plan)} change(s), ledger updated")

def need_reason(args):
    if not args.reason: sys.exit("roster: --reason is required for changes")

def history_update(person, group, team, eff):
    h = read_csv(HISTORY)
    for x in h:
        if x["person"] == person and not x["effective_to"]: x["effective_to"] = eff
    h.append({"person": person, "effective_from": eff, "effective_to": "", "group": group, "team": team})
    write_csv(HISTORY, h, HISTORY_COLS)

# ---- reads -------------------------------------------------------------------------------------------------------
def cmd_list(a):
    rows = [r for r in load() if not (a.group and norm(r["group"]) != norm(a.group)) and not (a.team and norm(r["team"]) != norm(a.team))
            and not (a.manager and norm(r["manager"]) != norm(a.manager)) and not (a.source and norm(a.source) not in norm(r["note"]))]
    if not a.all: rows = [r for r in rows if not r["end_date"]]
    emit(rows, ["name", "group", "team", "manager", "title", "end_date"], a)

def cmd_show(a):
    rows = load(); r = find(rows, a.person, strict=False)
    ident = next((i for i in read_csv(IDENT) if i["person"] == r["name"]), {})
    hist = [x for x in read_csv(HISTORY) if x["person"] == r["name"]]
    led = [x for x in read_csv(LEDGER) if x["person"] == r["name"]]
    if a.json: print(json.dumps({"roster": r, "identity": ident, "history": hist, "ledger": led}, indent=1, ensure_ascii=False)); return
    for k, v in r.items(): print(f"{k:12} {v}")
    print("identity:", {k: v for k, v in ident.items() if v and k != "person"} or "none recorded")
    print("team/group history:"); [print("  ", x["effective_from"], "->", x["effective_to"] or "now", "|", x["group"], "|", x["team"]) for x in hist]
    print(f"ledger lines: {len(led)}")

def cmd_history(a):
    r = find(load(), a.person, strict=False)
    led = [x for x in read_csv(LEDGER) if x["person"] == r["name"]]
    emit(led, LEDGER_COLS, a, f"ledger for {r['name']}")

def cmd_export(a):
    rows = load()
    if a.json: print(json.dumps(rows, indent=1, ensure_ascii=False)); return
    out = open(a.out, "w", newline="") if a.out else sys.stdout
    import csv
    w = csv.DictWriter(out, fieldnames=ROSTER_COLS, lineterminator="\n"); w.writeheader(); [w.writerow(r) for r in rows]
    if a.out: out.close(); print(f"exported {len(rows)} rows to {a.out}")

def cmd_diff(a):
    cur = {r["name"]: r for r in load()}; snap = {r["name"]: r for r in read_csv(DATA / "roster_last_sync.csv")}
    if not snap: sys.exit("roster: no last-sync snapshot yet; run `roster sync` first")
    d = []
    for n in sorted(set(cur) | set(snap)):
        if n not in snap: d.append({"person": n, "change": "added since sync"})
        elif n not in cur: d.append({"person": n, "change": "removed since sync"})
        else:
            for f in ("group", "team", "manager", "title", "end_date"):
                if cur[n][f] != snap[n][f]: d.append({"person": n, "change": f"{f}: {snap[n][f]!r} -> {cur[n][f]!r}"})
    emit(d, ["person", "change"], a, "roster vs last sync")

# ---- writes ------------------------------------------------------------------------------------------------------
def finish(rows, plan, a):
    if not plan: print("nothing to change"); return
    if confirm(plan, a): write_with_ledger(rows, plan, a)

def cmd_add(a):
    need_reason(a); rows = load()
    if any(norm(r["name"]) == norm(a.person) or norm(r["chart_name"]) == norm(a.person) for r in rows): sys.exit(f"roster: {a.person!r} is already on the roster")
    if a.group and a.group.upper() not in GROUPS: print(f"note: {a.group!r} is not one of the four groups; the person will count under Other")
    new = {"name": a.person, "chart_name": a.chart_name or a.person, "manager": a.manager or "", "title": a.title or "",
           "group": (a.group or "").upper(), "team": a.team or "", "start_date": a.start or today(), "end_date": "", "note": a.note or ""}
    plan = [(a.person, f, "", v) for f, v in new.items() if v and f not in ("chart_name",)] or [(a.person, "name", "", a.person)]
    plan = [(a.person, "add", "", json.dumps({k: v for k, v in new.items() if v}, ensure_ascii=False))]
    print("PLAN preview of new row:", {k: v for k, v in new.items() if v})
    if confirm(plan, a):
        rows.append(new); write_with_ledger(rows, plan, a); history_update(a.person, new["group"], new["team"], new["start_date"])

def cmd_remove(a):
    need_reason(a); rows = load(); r = find(rows, a.person); on = a.on or today()
    if r["end_date"]: sys.exit(f"roster: {r['name']} already has end_date {r['end_date']}")
    plan = [(r["name"], "end_date", "", on)]
    if confirm(plan, a):
        r["end_date"] = on; write_with_ledger(rows, plan, a)
        h = read_csv(HISTORY)
        for x in h:
            if x["person"] == r["name"] and not x["effective_to"]: x["effective_to"] = on
        write_csv(HISTORY, h, HISTORY_COLS)

def setter(field, label=None):
    def f(a):
        need_reason(a); rows = load(); r = find(rows, a.person); new = a.value
        if field == "group" and new: new = new.upper()
        if field == "group" and new and new not in GROUPS: print(f"note: {new!r} is not one of the four groups; counts under Other")
        plan = [(r["name"], field, r[field], new)] if r[field] != new else []
        if plan and confirm(plan, a):
            r[field] = new; write_with_ledger(rows, plan, a)
            if field in ("group", "team"): history_update(r["name"], r["group"], r["team"], a.on or today())
        elif not plan: print("nothing to change")
    return f

def cmd_set_identity(a):
    need_reason(a); rows = load(); r = find(rows, a.person)
    sel = {k: v for k, v in (("jira", a.jira), ("github", a.github), ("gitlab", a.gitlab)) if v}
    if not sel: sys.exit("roster: give at least one of --jira --github --gitlab")
    ov = read_csv(OVERRIDES); plan = []
    for s, h in sel.items():
        old = next((o["handle"] for o in ov if o["person"] == r["name"] and o["system"] == s and o["handle"]), "")
        plan.append((r["name"], f"identity.{s}", old, h))
    print(f"PLAN: writes {OVERRIDES} (identity override rows) and the ledger; `identity.py` applies them to identity.csv")
    if confirm(plan, a):
        ov = [o for o in ov if not (o["person"] == r["name"] and o["system"] in sel)]
        for s, h in sel.items(): ov.append({"person": r["name"], "system": s, "handle": h, "reason": a.reason, "candidates": ""})
        write_csv(OVERRIDES, ov, ["person", "system", "handle", "reason", "candidates"])
        for p, f, b, af in plan: ledger_append("set-identity", p, f, b, af, ("[scratch] " if a.scratch else "") + a.reason)
        print("applied: overrides written (run tools/roster/identity.py --only <person> to refresh identity.csv)")

def cmd_ignore(a, undo=False):
    need_reason(a); ig = read_csv(IGNORE); k = norm(a.person)
    has = [i for i in ig if norm(i["name"]) == k]
    if undo and not has: sys.exit("roster: not on the ignore list")
    if not undo and has: sys.exit("roster: already ignored")
    plan = [(a.person, "ignore", "ignored" if undo else "", "" if undo else "ignored")]
    if confirm(plan, a):
        ig = [i for i in ig if norm(i["name"]) != k] if undo else ig + [{"name": a.person, "decided": today(), "reason": a.reason}]
        write_csv(IGNORE, ig, ["name", "decided", "reason"])
        ledger_append("unignore" if undo else "ignore", a.person, "ignore", plan[0][2], plan[0][3], ("[scratch] " if a.scratch else "") + a.reason)
        print("applied")

def cmd_import(a):
    need_reason(a); new = read_csv(a.file); cur = {r["name"]: r for r in load()}
    if not new or "name" not in new[0]: sys.exit("roster: import file needs a header with a `name` column")
    plan = []
    for n in new:
        c = cur.get(n["name"])
        if not c: plan.append((n["name"], "add", "", "row"))
        else:
            for f in ROSTER_COLS:
                if f in n and n[f] != c[f]: plan.append((n["name"], f, c[f], n[f]))
    for n in cur:
        if n not in {x["name"] for x in new}: plan.append((n, "missing from file", "kept", "kept (import never deletes)"))
    plan = [p for p in plan if p[1] != "missing from file"] or []
    if not plan: print("nothing to change"); return
    if confirm(plan, a):
        rows = load(); by = {r["name"]: r for r in rows}
        for n in new:
            if n["name"] in by: by[n["name"]].update({f: n[f] for f in ROSTER_COLS if f in n})
            else: rows.append({f: n.get(f, "") for f in ROSTER_COLS})
        write_with_ledger(rows, plan, a, "import")

# ---- sync (proposals only) ----------------------------------------------------------------------------------------
def cmd_sync(a):
    """Re-read the department page (and org chart names file) and PROPOSE changes. Applies only with --apply-lines."""
    py = sys.executable; scratch = DATA / "extracts" / "roster"; scratch.mkdir(parents=True, exist_ok=True)
    here = pathlib.Path(__file__).parent
    if a.from_dept_json: dj = a.from_dept_json
    else:
        txt = scratch / "dept_page_sync.txt"; dj = str(scratch / "dept_sync.json")
        r = subprocess.run(["/opt/homebrew/opt/python@3.14/bin/python3.14", "-I", str(here / "dept_dump.py"), str(txt)], capture_output=True, text=True)
        if r.returncode: sys.exit("roster sync: could not read the department page:\n" + r.stderr[-400:])
        subprocess.run([py, str(here / "dept_parse.py"), str(txt), dj], check=True, capture_output=True)
    dept = json.load(open(dj))["rows"]; rows = load(); ign = {norm(i["name"]) for i in read_csv(IGNORE)}
    idx = {}
    for r in rows: idx[norm(r["chart_name"])] = r; idx[norm(r["name"])] = r
    mem = collections.defaultdict(list)
    for d in dept:
        p_ = idx.get(norm(d["name"]))
        if p_: mem[p_["name"]].append((d["group"], d["team"], d["section"]))
    # --- who is present on the org chart -------------------------------------------------------------------------
    import glob
    uname = {}                                         # username -> roster person name
    for i in read_csv(IDENT):
        if i.get("home_username"): uname[i["home_username"].lower()] = i["person"]
    for h in read_csv(DATA / "roster_home_usernames.csv"): uname[h["username"].lower()] = h["person"]
    tree_file = a.orgchart_tree or next(iter(sorted(glob.glob(str(ROOT / "data/extracts/roster/orgchart_tree_*.json")), reverse=True)), None)
    names_file = a.orgchart_json or next(iter(sorted(glob.glob(str(ROOT / "data/extracts/roster/orgchart_names_*.json")), reverse=True)), None)
    chart_names = {norm(x["name"]) for x in json.load(open(names_file))} if names_file else set()
    in_tree = set(); notes = []
    notes.append("org chart: could not be read live by this command; using the most recent saved reporting tree" if tree_file else "org chart: no saved reporting tree found; joiners from the chart cannot be proposed and leavers are judged on team pages only")
    if names_file: notes.append(f"saved expanded chart names {names_file}: no reporting lines, so used only to show who is present, never to propose joiners")
    props = []
    if tree_file:
        tr = json.load(open(tree_file)); notes.append(f"reporting tree: {tree_file} (root {tr['root']}; {tr['source']})")
        for n in tr["nodes"]:
            u = n["username"].lower(); person = uname.get(u)
            if person: in_tree.add(person)
            else:
                guess = norm(__import__("re").sub(r"\d+$", "", u).replace(".", ""))
                if not any(guess == norm(i)[:len(guess)] or guess in norm(i) for i in ign) and not any(p["person"] == u for p in props):
                    props.append({"kind": "add", "person": u, "field": "", "before": "", "after": "", "why": "under the head of engineering on the org chart, not on the roster (username shown; look up the name in Home)"})
    present = in_tree | set(mem) | {r["name"] for r in rows if norm(r["chart_name"]) in chart_names}
    for r in rows:
        if r["end_date"] or r["name"] in present: continue
        if "named by user" in r["note"] or "approved by user" in r["note"] or "added by roster sync" in r["note"]: continue
        props.append({"kind": "remove", "person": r["name"], "field": "end_date", "before": "", "after": today(), "why": "not on the org chart tree and not on any team page"})
    prod = {"Product Owners", "Product Owner", "User Experience", "Documentation"}
    import re as _re
    prodcode = _re.compile(r"^(?:.*PM\d?|.*UX\w*|[A-Z]?ID\d?)$")   # product manager, UX, documentation role codes
    secs = collections.defaultdict(set)
    for d in dept: secs[norm(d["name"])].add(d["section"] if not prodcode.match(d.get("code", "")) else "Product Owners")
    for d in dept:
        k = norm(d["name"])
        if k in idx or k in ign or any(p["kind"] == "add" and norm(p["person"]) == k for p in props): continue
        if secs[k] <= prod: continue                     # product, UX, docs: not proposed by default
        props.append({"kind": "add", "person": d["name"], "field": "", "before": "", "after": f"{d['group']} | {d['team']}", "why": "on a team page, not on the roster"})
    # team/group changes: where the person is on a team page and the roster team is not among their teams
    for r in rows:
        if r["end_date"] or r["name"] not in mem: continue
        teams = {(g, t) for g, t, s in mem[r["name"]] if s not in ("Backup Contact", "Technical Advisor", "Technical Advisors")}
        if r["team"] and (r["group"], r["team"]) not in teams and teams:
            one = sorted(teams)
            props.append({"kind": "set-team", "person": r["name"], "field": "group|team", "before": f"{r['group']} | {r['team']}", "after": " OR ".join(f"{g} | {t}" for g, t in one), "why": "roster team not on any of this person's team-page entries"})
    for i, p in enumerate(props, 1): p["line"] = i
    write_csv(DATA / "roster_sync_proposals.csv", props, ["line", "kind", "person", "field", "before", "after", "why"])
    write_csv(DATA / "roster_last_sync.csv", rows, ROSTER_COLS)
    for n_ in notes: print("note:", n_, file=sys.stderr)
    if a.json: print(json.dumps(props, indent=1, ensure_ascii=False))
    else: emit(props, ["line", "kind", "person", "before", "after", "why"], a, "PROPOSALS (nothing applied)")
    if a.apply_lines:
        need_reason(a); want = {int(x) for x in a.apply_lines.split(",")}; plan = []
        for p in props:
            if p["line"] in want:
                if p["kind"] == "remove": plan.append((p["person"], "end_date", "", p["after"]))
                elif p["kind"] == "add": plan.append((p["person"], "add", "", p["after"]))
                else: print(f"line {p['line']} ({p['kind']}) has several options; apply it with set-group / set-team");
        if plan and confirm(plan, a):
            for pn, f, b, af in plan:
                if f == "end_date": next(r for r in rows if r["name"] == pn)["end_date"] = af
                else:
                    g, _, t = af.partition(" | "); rows.append({"name": pn, "chart_name": pn, "manager": "", "title": "", "group": g.strip(), "team": t.strip(), "start_date": today(), "end_date": "", "note": "added by roster sync"})
            write_with_ledger(rows, plan, a, "sync")

# ---- parser ------------------------------------------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser(prog="roster", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    def add(name, fn, write=False, **kw):
        p = sp.add_parser(name, help=kw.pop("help", None)); p.set_defaults(fn=fn)
        p.add_argument("--json", action="store_true", help="machine-readable output (reads)")
        if write:
            p.add_argument("--reason"); p.add_argument("--dry-run", action="store_true", help="show the PLAN and write nothing")
            p.add_argument("--apply", action="store_true", help="you have seen the PLAN; write without the prompt")
            p.add_argument("--scratch", action="store_true", help="mark ledger lines as scratch/test")
            p.add_argument("--as-user", action="store_true", help="the user runs this by hand: ledger records 'via user' when DASHBOARD_AGENT is unset")
        return p
    p = add("list", cmd_list, help="list people"); [p.add_argument(f"--{x}") for x in ("group", "team", "manager", "source")]; p.add_argument("--all", action="store_true", help="include ended people")
    p = add("show", cmd_show, help="identities, history, ledger for one person"); p.add_argument("person")
    p = add("history", cmd_history, help="ledger lines for one person"); p.add_argument("person")
    p = add("diff", cmd_diff, help="roster vs last sync")
    p = add("export", cmd_export, help="write the roster as CSV"); p.add_argument("--out")
    p = add("add", cmd_add, True, help="add a person"); p.add_argument("person"); [p.add_argument(f"--{x}") for x in ("group", "team", "manager", "title", "note", "start", "chart-name")]
    p = add("remove", cmd_remove, True, help="end-date a person (history kept)"); p.add_argument("person"); p.add_argument("--on")
    for fld in ("team", "group", "manager", "title", "note"):
        p = add(f"set-{fld}", setter(fld), True, help=f"change {fld}"); p.add_argument("person"); p.add_argument("value"); p.add_argument("--on", help="effective date (team/group)")
    p = add("set-identity", cmd_set_identity, True, help="set Jira, GitHub, GitLab handles (writes the overrides file)"); p.add_argument("person"); [p.add_argument(f"--{x}") for x in ("jira", "github", "gitlab")]
    p = add("ignore", cmd_ignore, True, help="keep a name out of sync proposals"); p.add_argument("person")
    p = add("unignore", lambda a: cmd_ignore(a, True), True, help="allow sync to propose a name again"); p.add_argument("person")
    p = add("import", cmd_import, True, help="load a roster CSV (PLAN first; never deletes)"); p.add_argument("file")
    p = add("sync", cmd_sync, True, help="re-read the department page and org chart; PROPOSE joiners, leavers, team changes")
    p.add_argument("--from-dept-json", help="use a saved parsed department page instead of the browser"); p.add_argument("--orgchart-json", help="saved org chart names (list of {name}); presence only"); p.add_argument("--orgchart-tree", help="saved reporting tree (default: newest orgchart_tree_*.json)"); p.add_argument("--apply-lines", help="comma list of proposal line numbers to apply (add/remove only)")
    a = ap.parse_args()
    if a.cmd in ("list", "show", "history", "diff", "export", "sync"): a.reason = getattr(a, "reason", None); a.dry_run = getattr(a, "dry_run", False); a.apply = getattr(a, "apply", False); a.scratch = getattr(a, "scratch", False)
    import common; common.AS_USER = bool(getattr(a, "as_user", False))
    a.fn(a)

if __name__ == "__main__": main()
