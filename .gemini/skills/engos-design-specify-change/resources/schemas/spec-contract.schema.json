{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecContract.v1",
  "description": "Optional interchange shape for a requirements draft or accepted specification. Validation does not establish ID uniqueness by property, source truth, reference existence, authority, approval, assumption reconciliation, semantic correctness or implemented behavior. Review these separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_refs",
    "authority_ref",
    "entry_order",
    "requirements",
    "non_goals",
    "assumptions",
    "design_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "SpecContract.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "authority_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "entry_order": {
      "enum": [
        "requirements_first",
        "design_first",
        "bugfix"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "condition",
          "behavior",
          "acceptance",
          "unchanged_behavior",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "behavior": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "unchanged_behavior": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could",
              "undecided"
            ]
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "open",
              "confirmed",
              "rejected",
              "deferred"
            ]
          },
          "decision_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "design_refs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "bug_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_behavior",
        "expected_behavior",
        "unchanged_behavior"
      ],
      "properties": {
        "current_behavior": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "unchanged_behavior": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entry_order": {
            "const": "bugfix"
          }
        },
        "required": [
          "entry_order"
        ]
      },
      "then": {
        "required": [
          "bug_context"
        ]
      }
    }
  ]
}
