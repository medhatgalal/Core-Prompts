  MP -->|Accepted counts with existing role| PM

  classDef primary fill:#326ce5,stroke:#1a3e7a,color:#ffffff
  classDef secondary fill:#4fc3f7,stroke:#0277bd,color:#01579b
  classDef client fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
