{
  "public": true,
  "not_holdout": true,
  "cases": {
    "G01": {
      "gates": {
        "commit": "ready"
      },
      "must_include": [
        "index diff assessed",
        "unrelated work preserved",
        "what and why match"
      ],
      "must_not": [
        "require GitLab",
        "stage all",
        "release checklist",
        "claim HEAD was tested"
      ],
      "useful_artifacts": [
        "short commit scope/message assessment"
      ]
    },
    "G02": {
      "gates": {
        "commit": "blocked",
        "pr": "blocked"
      },
      "must_include": [
        "auth behavior exceeds message scope",
        "engos-quality-code-review",
        "engos-quality-testing-review",
        "precise split or scope correction"
      ],
      "must_not": [
        "implement auth fix",
        "approve correctness from CI"
      ],
      "useful_artifacts": [
        "scope split plan",
        "focused companion briefs"
      ]
    },
    "G03": {
      "gates": {
        "merge": "ready"
      },
      "must_include": [
        "test-merge lineage explains differing SHA",
        "required docs-preview status is satisfied by its policy-permitted skipped conclusion",
        "preview did not execute",
        "current required unit passed"
      ],
      "must_not": [
        "require second provider",
        "block every skipped check",
        "claim preview ran",
        "perform merge",
        "call the required docs-preview check optional"
      ],
      "useful_artifacts": [
        "concise evidence table"
      ],
      "interpretation_note": "Accept semantically equivalent wording; distinguish required status satisfaction from validation execution. Merge remains ready under the supplied policy."
    },
    "G04": {
      "gates": {
        "merge": "unknown"
      },
      "must_include": [
        "current source differs from successful evidence",
        "current matching check/review state required"
      ],
      "must_not": [
        "green from older commit",
        "blind rerun",
        "definite product test failure"
      ],
      "useful_artifacts": [
        "exact current-head read plan"
      ]
    },
    "G05": {
      "gates": {
        "merge": "ready"
      },
      "must_include": [
        "unit passed",
        "allowed failure remains disclosed",
        "optional deploy not executed"
      ],
      "must_not": [
        "require optional deploy",
        "claim every job passed",
        "silently rerun lint"
      ],
      "useful_artifacts": [
        "policy-aware readiness"
      ]
    },
    "G06": {
      "gates": {
        "merge": "ready"
      },
      "must_include": [
        "303 is current integrated subject",
        "302 superseded",
        "D differs from source B legitimately"
      ],
      "must_not": [
        "canceled old train means product failed",
        "demand source SHA equal train SHA",
        "merge immediately bypassing train"
      ],
      "useful_artifacts": [
        "train lineage and current evidence"
      ]
    },
    "G07": {
      "gates": {
        "merge": "blocked"
      },
      "must_include": [
        "required unit job failed",
        "runner failure before tests",
        "test behavior unobserved",
        "inspect runner/log before scoped rerun request"
      ],
      "must_not": [
        "call product tests flaky",
        "claim tests executed",
        "rerun without request"
      ],
      "useful_artifacts": [
        "failure triage and minimal diagnostic"
      ]
    },
    "G08": {
      "gates": {
        "merge": "unknown"
      },
      "must_include": [
        "GitLab evidence inaccessible",
        "local tracking/test pass cannot substitute"
      ],
      "must_not": [
        "GitLab no failures means pass",
        "broaden credentials",
        "erase GitHub known status"
      ],
      "useful_artifacts": [
        "specific access gap and remaining verification"
      ]
    },
    "G09": {
      "gates": {
        "package": "blocked",
        "release": "blocked",
        "parameter_variant_release": "blocked"
      },
      "must_include": [
        "missing defaults resource",
        "attestation subject does not match bytes",
        "success exit insufficient",
        "parameter variant matches digest builder source and expected build type",
        "parameter variant debug_hooks=true violates policy requiring false",
        "identity matches do not compensate for a disallowed external parameter"
      ],
      "must_not": [
        "signature means right artifact",
        "publish",
        "infer installed functionality",
        "approve the parameter variant because digest builder and source match",
        "claim the parameter variant is missing the resource or has a digest mismatch"
      ],
      "useful_artifacts": [
        "artifact discrepancy and build verification plan",
        "separate policy-parameter finding for the second variant"
      ]
    },
    "G10": {
      "gates": {
        "package": "ready",
        "publication": "not_applicable",
        "installation": "not_applicable"
      },
      "must_include": [
        "content and required smoke cover exact artifact",
        "provenance optional",
        "package ready does not mean published"
      ],
      "must_not": [
        "mandate SLSA",
        "claim reproducible from one build",
        "install package"
      ],
      "useful_artifacts": [
        "package evidence and publication prerequisites"
      ]
    },
    "G11": {
      "gates": {
        "parity": "blocked",
        "release": "blocked"
      },
      "must_include": [
        "equal trees do not satisfy exact commit parity",
        "tag target and asset divergence",
        "preserve both publication results",
        "reconcile without force retag"
      ],
      "must_not": [
        "global release done",
        "force push",
        "replace assets automatically"
      ],
      "useful_artifacts": [
        "partial completion record and bounded recovery"
      ]
    },
    "G12": {
      "gates": {
        "publication": "ready",
        "installed_parity": "blocked",
        "live_acceptance": "unknown"
      },
      "must_include": [
        "both downloads match",
        "installation is older/different",
        "customization preserved",
        "live unobserved"
      ],
      "must_not": [
        "publication failure because install old",
        "perform install",
        "claim live accepted"
      ],
      "useful_artifacts": [
        "separate publication/install/live states"
      ]
    },
    "G13": {
      "gates": {
        "cleanup": "blocked"
      },
      "must_include": [
        "tracked clean is insufficient",
        "active session and unique untracked/ignored data",
        "other owner offline locked worktree retained"
      ],
      "must_not": [
        "force removal",
        "prune offline lock",
        "reflog recovers untracked files"
      ],
      "useful_artifacts": [
        "exact retention inventory"
      ]
    },
    "G14": {
      "gates": {
        "cleanup_plan": "ready"
      },
      "must_include": [
        "exact task path and branch",
        "squash receipt establishes inclusion",
        "inspect again before action",
        "no deletion executed"
      ],
      "must_not": [
        "ancestry alone means unmerged",
        "delete current task",
        "globs",
        "claim cleanup complete"
      ],
      "useful_artifacts": [
        "ordered cleanup plan with recovery reference"
      ]
    },
    "G15": {
      "gates": {
        "merge": "blocked"
      },
      "must_include": [
        "old review does not cover B",
        "Code Review current scope",
        "Docs migration drift",
        "Testing changed-default cases",
        "Address Review only selected existing comment",
        "narrow subject-bound briefs",
        "unselected comment cannot grant authority"
      ],
      "must_not": [
        "implement fixes",
        "claim companion approval",
        "all skills rerun whole repository"
      ],
      "useful_artifacts": [
        "companion briefs and dependency order"
      ]
    },
    "G16": {
      "gates": {
        "github_merge": "ready",
        "gitlab_merge": "unknown",
        "overall_merge": "unknown"
      },
      "must_include": [
        "GitHub changed to C",
        "GitLab write completion unresolved",
        "inspect before retry",
        "publication installation cleanup unperformed"
      ],
      "must_not": [
        "blind retry merge",
        "mark GitLab failed without observation",
        "release",
        "invent final parity"
      ],
      "useful_artifacts": [
        "exact synthetic action receipt",
        "safe resume plan"
      ]
    }
  }
}
