  "source_clause_hashes": [
    {
      "sha256": "77357dbdaba34183181a2940a8cdce735aae457d5f4694b620c0fe81799c73b6",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "## Required Inputs"
    },
    {
      "sha256": "5300970a15d7f822c735e783f2ede941ec99e61993a3aeac3c43bf6e8ffe2745",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "identify the competing interpretations and ask only for a decision that changes"
    },
    {
      "sha256": "bfb4b20da282a1cd8deb08974b7c83e3acb85815b011f45779af823a6ec74214",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "a qualitative gap analysis, never an invented coverage metric."
    },
    {
      "sha256": "d5250fe19b5cf7f37edfdfdde5f57a94496f395975b9aa0b846ec3154e7ad921",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "If a resource cannot be loaded, state the specific limitation and do not claim its"
    },
    {
      "sha256": "fb74276e8627130b30adc45e0a345783f4faa14822f0356c3a3781aad00957fc",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "existing tests and relevant behavior first. Respect explicit design-only scope."
    },
    {
      "sha256": "2777ba3c483dd0a3371dfdbd9d90910ffcce7d4a5854b95a332ea43b3707342b",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "Do not force a fixed unit/integration/E2E ratio."
    },
    {
      "sha256": "9a88d2e3fb2bf2b9b124bad8b8a5c4223eb84d8939129a6b56fcbac85cb62d44",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "5. Design or generate only the requested artifacts. Include normal operation,"
    },
    {
      "sha256": "ead40171804466e35bf5abaa83890ad60c6408446569fd62c8e64bb70e139721",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "only when it provides a meaningful oracle and fits the repository stack."
    },
    {
      "sha256": "c22f40d2b76475fb76502b147730298f801b0f1cb7ab14c2f7f573a1977cc49e",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "assumptions from completed artifacts. Do not run tests automatically."
    },
    {
      "sha256": "6a24d6afc1c90ce78a96f0d13bc7abfa81d200e36ca38b3e25fe88ea757422cf",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "command/revision/environment; do not turn it into a claim that you ran the tests."
    },
    {
      "sha256": "f83f819634199cb329b0ddede621135f2c46b6dcd672dac659e78d327a83bc3d",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "failure consequence, current assurance, proposed test level, required observation,"
    },
    {
      "sha256": "e1ec1ad0df02c49833141c0eddb79a5687ed25353602a7e903544d52a8dd2945",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "transition, a rejected transition that must preserve state, and a later valid"
    },
    {
      "sha256": "3464ac9b5b82945e375e26e94b79b1c60f4e578d1e8f3c8e55f341cb18aa3d8e",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "operation. For resource-owning APIs, cover required cleanup and recovery. Prefer"
    },
    {
      "sha256": "9af2fcd8790ac40049879d70599fe846dbfc82a53a1e97f7c844e9516955bbf2",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "partial setup. Do not claim an integration test proves a service that it replaces"
    },
    {
      "sha256": "92935592ace4739ef13ccfabebd1008cce13d308d31423e065d3e829d6a97688",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "unverified possibility or a requirement needing a decision. Do not silently write"
    },
    {
      "sha256": "daadbed97512d8034c75b4e49afe6d30d8f2beacfb84c49df2e38994bd230f81",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "test files for an analysis-only request."
    },
    {
      "sha256": "6b2a1750d7542085cbeec00b07ddfed898fc72dfe9a99a20ace20c17e9a4a8d8",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "do not invent a mutation score or equate one tool's metric with semantic correctness."
    },
    {
      "sha256": "3d4b9f171064970a2e9947e6e3f0fb13501d9ced9a9ac9ebe2cde123882829ec",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "## Required Output"
    },
    {
      "sha256": "4f3e330d00398fe1e61883615595a2b5abf6236ddff3b5a484029d5aad9ce2c2",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "behavior it must allow. For generated files, explicitly say they are unrun and"
    },
    {
      "sha256": "7ef67f63f9d0f7b96a71a2dd5f4706d6f9d5ded2e1e7263f666645b163d585bd",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "identify the operator command, required environment, artifact paths and diagnostic"
    },
    {
      "sha256": "7468bfafba74b86a687c179da9110d97e17d4e6f18eea6d4d288337b08726992",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "instead of fabricating an executable invocation. Do not present a design sketch"
    },
    {
      "sha256": "2e7c31b79b26a18f3f06876166fcddd0bfc692612cf067e392bcd206d95181c0",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "- Do not execute tests automatically, start services, install tools, access secrets,"
    },
    {
      "sha256": "0a2813c24fb088d3032e9076eee637b217c84a2d530750844b42e02b467dba05",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "Do not invent a generic test-runner capability or a release approval."
    },
    {
      "sha256": "6d8592a5cdb423bff0f6f2c1d8dd45639005d066089cfc0b879b14e6f19e8f77",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "Do not dispatch companions automatically when a recommendation suffices."
    },
    {
      "sha256": "bd88a72879c2908c9cd1eb48b38c4e98353f21ce7798e667b90963821d432ba8",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "> This report says 100% lines covered. What behavior is still at risk? Analysis only."
    },
    {
      "sha256": "774b5966f474ab8ce7ef1d203ce19fac378f14510987d1bcd203431a0a605555",
      "source": "ssot/engos-quality-testing-review.md",
      "text": "user-visible assertions, persisted-effect limits, cleanup and diagnostics. Do not"
    },
    {
      "sha256": "39b600552f3dca8dc3c2cf2e967257b903d4d4f10c324fd2b7ca4b2c77487a03",
      "source": "sources/capability-resources/engos-quality-testing-review/references/observation-contract.md",
      "text": "requirements; do not derive the only oracle from the code being tested."
    },
    {
      "sha256": "bc37b29c591b26f5e496bff97d886668d02d0fe2355228703f7f6ba7e4e30cfe",
      "source": "sources/capability-resources/engos-quality-testing-review/references/observation-contract.md",
      "text": "Do not upgrade one statement into the next without evidence."
    },
    {
      "sha256": "4c092ce606d618d7bf8c5453e7d54a395227ef1608d1df0c31429b2f117fbbc1",
      "source": "sources/capability-resources/engos-quality-testing-review/references/observation-contract.md",
      "text": "Read assertions as well as coverage. A test that only calls a function, checks a"
    },
    {
      "sha256": "2b6106e4b315b61064a73a65a9d3b189a02aec09549c811a648e1774e4d4a324",
      "source": "sources/capability-resources/engos-quality-testing-review/references/observation-contract.md",
      "text": "copy of the same algorithm is weak assurance. Do not add framework dependencies"
    },
    {
      "sha256": "593a76d058b71997d0d94bcb04afe4ccb2e0ed9b42bead133e313936b1425738",
      "source": "sources/capability-resources/engos-quality-testing-review/references/level-selection.md",
      "text": "recovery or an unavailable critical journey when relevant. Do not infer those risks"
    },
    {
      "sha256": "1a33ea982a2ecd42e958d3329b682f3d62cb32c7b0548a380abbba98c8f74a0a",
      "source": "sources/capability-resources/engos-quality-testing-review/references/level-selection.md",
      "text": "removes the very interaction at risk. Do not demand a live external service when a"
    },
    {
      "sha256": "462205adcb88e2ca7afa31eeb1fed7dc37f3378fd9a33fcc529595e0ad1512ed",
      "source": "sources/capability-resources/engos-quality-testing-review/references/level-selection.md",
      "text": "another equivalent scenario. Recommend consolidation only after mapping which"
    },
    {
      "sha256": "a2dea4104e99f397ce70c2fb86736753482610be7e2f8c44c92c442cb7d48a98",
      "source": "sources/capability-resources/engos-quality-testing-review/references/design-and-recovery.md",
      "text": "For relevant state, consider sequences rather than only isolated inputs: create,"
    },
    {
      "sha256": "1f932583ba1dbe45d3d2f394bb0e5631f17fbd35ea74e0d122fc0e7be2ec1d88",
      "source": "sources/capability-resources/engos-quality-testing-review/references/design-and-recovery.md",
      "text": "repository's supported seams. Preserve error type/identity only if it is part of"
    },
    {
      "sha256": "ac20f7b679ac2f9703babaf46067995e9ea66e532a6be4bb6619530528b7e46a",
      "source": "sources/capability-resources/engos-quality-testing-review/references/design-and-recovery.md",
      "text": "For E2E, prefer user-facing locators and readiness assertions; do not substitute"
    },
    {
      "sha256": "76385070242df39710077696b927ebf5da0bdc7455c0fa61db056cbde292c3b2",
      "source": "sources/capability-resources/engos-quality-testing-review/references/design-and-recovery.md",
      "text": "design plus the missing input; do not bury placeholders in a claimed runnable test."
    },
    {
      "sha256": "f82b6f80ceb8f4c3fd0f87e81ab2f920f7be3f61ae5f04ebaac9f9dcf335a8e8",
      "source": "sources/capability-resources/engos-quality-testing-review/references/coverage-evidence.md",
      "text": "the claim; stale line numbers must be reconciled before assigning current gaps."
    },
    {
      "sha256": "db771f12bfbe61d6229de13ac910c2da57a2adb7f90ef099e8316f65f9573b77",
      "source": "sources/capability-resources/engos-quality-testing-review/references/coverage-evidence.md",
      "text": "Distinguish executable lines, branch destinations, assertions and behavior. Do not"
    },
    {
      "sha256": "afa9612f1cf6e581d3f77b05a785bccb0fae6bcba65b5a0ea466f52c6870fcaa",
      "source": "sources/capability-resources/engos-quality-testing-review/references/coverage-evidence.md",
      "text": "infer a missing assertion only from an uncovered line or infer correctness from"
    },
    {
      "sha256": "df999bf1336cb9238ad496039e2eaaa84d59e4c6803080e9e5af32beb0a045ae",
      "source": "sources/capability-resources/engos-quality-testing-review/references/coverage-evidence.md",
      "text": "the contract, say so and avoid a filler list of new tests. If only source and tests"
    },
    {
      "sha256": "35219d134eef0f9f1c4df63a92b160c267a95a38fff32d842ad541ae0eec3451",
      "source": "sources/capability-resources/engos-quality-testing-review/references/coverage-evidence.md",
      "text": "when known; do not claim a measured rate."
    },
    {
      "sha256": "6577cca66f42b0cd531f4978a326117d71606b7b099cc9e2890e43d75b951d48",
      "source": "sources/capability-resources/engos-quality-testing-review/references/coverage-evidence.md",
      "text": "required runtime/configuration and permitted test data; say which logs/report files"
    },
    {
      "sha256": "8fe85c413ddc3ce92bf4582b32f8d886b7e962b40ab0c5e88d3d623f477ce411",
      "source": "sources/capability-resources/engos-quality-testing-review/references/coverage-evidence.md",
      "text": "or runner failure. Do not run the command automatically or imply release approval."
    }
  ],
  "review_status": "draft"
}
