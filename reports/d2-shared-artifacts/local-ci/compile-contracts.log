          "34190ff1d43fbaffc4b8e45c4046c8c79e8ffdeda462240094c0510844d63f94",
          "70468255202b0bc81dac867684bf586ec1c80b51acfa2c62ce60ed6e6e3f03e7",
          "b7be70aac455d6397edc44ff9a18a0537779e1c7f99ff7faba82844fdc6e25ac",
          "34e6f4ec127393b17e2b24a30972f6cb806b8fd2ab75674628b4e63654bad667",
          "c3bb4c3c49b5503cd85182145a4a39e1fa934cf590fd1914d52028efd9d43c74",
          "62a0df5dab622761e87dff4a143e8ba145f1f2de2090dbf67a87f2d67b3d9f26",
          "af03cfd2445c36097789c937c28f7ae04e5a0de97c45306879d93441d5385f58",
          "09578547eb3051685556941cc2c612a97d9260fc1565f757dab6ea25ba50f769",
          "739eb25e75870bd9375502eb35ee691f49522a2de8a6ac826c407e16ba35f1b3",
          "39cf095ea39f8614bc0c9ac214a9e03d2394dcb77687aa1725208903b8051bca",
          "f9024ca8cd6609851c40e3cd9882920f70aa180f6d00529e7846f8a3990ee766",
          "1619a4b1efa7acd88b9822fa551d5da94b6451b4ca3a15334ddb2e0739015db1",
          "ea2c2d1bb54fe4a7c80da2f71443f08db2cab47b4ba610d309b79ca344ab695f",
          "a1a5bd232770d5d0573b5a234e2bb863b42098711932a1295dca82486639efd8",
          "8791a4786f39f1650cdfd7c4a177d68fec5817c70ee766a087b1e0e86225f4de",
          "94f83b18dddd03eef701151b56f7418498f3b9ac7b5aa87e917a9e3fbb7c3254",
          "80e2eca6e91e2369f66bb0879e5fe1b10903bcb2d48fcd509bd2c6abe1e2022d",
          "1d5dcb2a9912d866e1485be080033cb0a8a524210b470062b96c42416b706316"
        ],
        "editable_behavior": [],
        "primary_outcome": {
          "metric": "skill_specific_task_success",
          "definition": "Canonical task success with protected behavior preserved.",
          "threshold": "human_review_required"
        },
        "secondary_outcomes": [],
        "regression_limits": {
          "protected_binary_margin": 0.02,
          "critical_deterministic": "exact_pass"
        },
        "cost_latency_limits": {
          "profile_caps": {
            "static": 0,
            "native": 0,
            "routing-canary": 300000,
            "canary": 1250000,
            "promotion": 5000000,
            "cross-host": 12000000,
            "sweep": 30000000
          }
        },
        "runtime_envelope": {
          "required_cells": [],
          "cross_host_required_for_pilot": false,
          "status": "unresolved"
        },
        "promotion_rule": "Change-class-specific proof plus all hard gates; no aggregate compensation.",
        "rollback_trigger": "Any protected regression or stale bound evidence.",
        "source_clause_hashes": [
          {
            "sha256": "c96cd74da63d3012488de26f2409775cee81c7ca1841c64f0caedfd1ed3c3dd1",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Do not use this capability when the main job is prompt hardening, import classification, architecture design, or durable long-running analysis memory without a behavioral comparison goal."
          },
          {
            "sha256": "a350e3da719bdc3045eab4a0d3c2d2a39151c02f000f132111e436d112bb2af4",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Explore improvements by repeatedly mutating candidates, executing protected evaluations, scoring results, retaining improvements, and rejecting unsuccessful trials within the agreed limits. Return the best accepted candidate and auditable results relative to the original baseline. Prepare formal promotion evidence only when requested and supported; keeping a trial does not grant release or merge authority."
          },
          {
            "sha256": "f4310ac32ffd8de4cdfe52a6a7264f044e4bc0799299180789b8252bdb0f0ac3",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Use `python3 \"<resource-root>/scripts/load_module.py\" --route experiment --format text` for actual experiments. Routes `templates`, `bootstrap`, and `promotion` load the respective scaffolding or promotion resources. Read `resources/references/resource-delivery.md` on skill surfaces, or `references/resource-delivery.md` relative to the agent resource root. The map binds every required workflow, template, and bootstrap resource for effective review and identity checks."
          },
          {
            "sha256": "aea57beb5b1a6c34c0ea9297330ec41ffd836b6ff4f1c55035e5fbc45e1ed1b0",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "If the helper is unavailable, actual tools must supply the full shared and selected dependency contents before work; never substitute an assertion of reading, a hash, or a truncated excerpt. Missing or changed content requires recovery and rechecking. Passing resource delivery proves supplied bytes, not compliance or a successful experiment."
          },
          {
            "sha256": "7f7a95be10c5b81cd569e8257bf6906c6761cad49b4012a9f77bf314f7a05130",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "bin/capability-eval calibrate --static-only"
          },
          {
            "sha256": "812649042697ce72f41ff6117cbcef11a16446cdced28d91958b5ee8bbbb318d",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Valid statuses are `structural_ready`, `behavioral_pending`, `promote`, `hold`, `blocked_contract`, `inconclusive`, `rollback`, and `stale_evidence`. Never translate a structural UAC result into `promote`."
          },
          {
            "sha256": "8d831bbc8ef67ebbfe60d4e5be33a671a461605dea21bbf9180a38c96231ff6d",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Normal CI is `static` and uses zero model tokens. Model-mediated profiles require an explicit operator or workflow gate. A cap breach, missing required runtime, unqualified judge, stale hash, or surviving critical mutant returns `inconclusive`, `hold`, or `stale_evidence`; it never silently narrows the experiment."
          },
          {
            "sha256": "7c938e14f976f3ca92be740bf56dcb870dab112178e340888342404929dc3610",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- run real bounded improvement loops; label dry-run plans as unexecuted and never count simulated trials as experiments"
          },
          {
            "sha256": "e9e498ae4987e2dbc18311cfe9a5e3249dda5371030dfe58aac12199fd176a95",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- prepare change, commit, and merge guidance only after a candidate clears the promotion threshold"
          },
          {
            "sha256": "3544543b4c3b771c875f41bbe48f2e4de69b1ffa312fb72941939a57f35e7582",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "The agent surface must never imply unconditional runtime authority. It may recommend, prepare, and validate. It must respect human review gates before promotion unless the user explicitly allows automated action inside the host system."
          },
          {
            "sha256": "01d40c6b796f948458e84e26c0e4e94d756077b493d87378bda101b9bfeab700",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- forbidden: claiming an unmeasured improvement, silently widening the editable scope, hiding regressions behind aggregate scores, or merging changes without explicit policy support"
          },
          {
            "sha256": "8c902773a407c5d57ab48d41a81a292a66e766793f244a951801a9e6ff783938",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Use the user's requested destination or an appropriate existing project location for requested durable deliverables, with stable filenames such as `goal-contract.md`, `experiment-ledger.md`, and `scorecard.json`. Create a promotion packet or trace-to-eval artifact only when that workflow calls for it. Update the same authorized artifacts; use Git for durable revision history rather than timestamped or numbered copies."
          },
          {
            "sha256": "b9ee662317b822d567d2ef2797d08a7ccf6326c9f0e799ff99c175c333adff67",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Executed experiments need one isolated task working area containing the original baseline, current best, active trial, and a single ledger of actual results. Keep disposable trial files in temporary storage, discard rejected active changes, and retain the useful evidence and candidate identities in the ledger or Git. Do not accumulate a directory of permanent prompt versions or load experiment outputs as skill instructions. Preserve unrelated files and active work."
          },
          {
            "sha256": "fc5ec02a80d0a34f53ba09bc85df53ba08fa51447938c84ab99124d9fe5cdf33",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "7. For diagnosis, use the cheapest discriminating check. For authorized optimization, generate bounded trial candidates from the best accepted state and replay them in isolation using the protected evaluation. Setup checks must not replace the requested search loop."
          },
          {
            "sha256": "5cf268c7ff921506a93b3a1a7056dcfe4a10dcb5cb77c69237047b2eb701f997",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "10. Keep accepted trial improvements, discard rejected active changes while retaining results, and continue the declared search. When formal promotion is requested, prepare only for verified winners:"
          },
          {
            "sha256": "7508be9ead9c29a6115e024147ba2c4dc22d1da8ffd928a6e77d90be33abf320",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Every Auto-Research run must end in one of these states:"
          },
          {
            "sha256": "41f58abe6c3fd930e36ba2ee18bb9d08233428135cc1a9052fb5cd334f7d31b5",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Never end with an ambiguous \u201clooks better\u201d conclusion. Choose one state and explain why."
          },
          {
            "sha256": "4b8080d3e0ad3083f3294bc9b65bc70c996682eed4bcfba44b8ff3aa90d7d42b",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Define a bounded editable surface. A trial may mutate one or several coordinated elements within it; record the joint hypothesis. Isolate changes when attribution matters, but do not prohibit interacting changes needed to test a hypothesis."
          },
          {
            "sha256": "ca133c000e119317d1df78337b8aba3631d0f234e2a7a19947bc95c493f68ec0",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Never present novelty as evidence."
          },
          {
            "sha256": "77357dbdaba34183181a2940a8cdce735aae457d5f4694b620c0fe81799c73b6",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "## Required Inputs"
          },
          {
            "sha256": "3d4b9f171064970a2e9947e6e3f0fb13501d9ced9a9ac9ebe2cde123882829ec",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "## Required Output"
          },
          {
            "sha256": "c34906b1f1c3c14200786d7b39a7be48ac5a703827301490b4f5a4403f82b6e1",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Every substantial response must include:"
          },
          {
            "sha256": "9f5eb701b5e0e53cb4530b70c99415b946efc97e138e3718b42606e7d4140a0a",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "For bounded local investigations that do not justify a broad search loop yet, a compressed output is allowed:"
          },
          {
            "sha256": "75bc1c7fdb872b212c025a001aed10b028e687d2a01abb380dfe74b17efa034d",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Auto-Research must guide the user through this sequence:"
          },
          {
            "sha256": "0bedb8cce7648b83be4efe961cd0d6d34368dffc15b32c8c79e5270479a597cc",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- what must be true before a candidate is allowed to proceed to commit or merge"
          },
          {
            "sha256": "30bb6a8d221c9cd94b16a6a0f2da239942c518c6d40ba7855f9fec1ab691e4dc",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- the minimum required setup inputs"
          },
          {
            "sha256": "d9b877a9ba77df8ad361be7c63e2c23a7e84c22fbdd697e877637679da6130ab",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- produce only the goal contract, assumptions, missing evidence, and a no-edit starting recommendation"
          },
          {
            "sha256": "928891b17115e00d5c2d6a240ca5bc7e78677d368f3bc6c4f78fd6a7328071ad",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Must not change:"
          },
          {
            "sha256": "ba9c8a7ac10d7c0d926a0dd63f1cc1cc762231618df0de2c832026b9b7faeaa3",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- <what must improve, what must not regress>"
          },
          {
            "sha256": "126170cdb763ebfd762bb9893d17f3a77f52b9f90359fb62de58802611c6f0c2",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Use the Python helper only when the operator wants those templates materialized immediately with fields already filled in."
          },
          {
            "sha256": "2f711d491f9d1f5e02ea0786c81383384cdc366d2665aa9e37d7465b287d0042",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "--must-not-change \"<protected surface>\" \\"
          },
          {
            "sha256": "339859e792edad0e88efbf9c03420c4a7d5ccd1d7cd0fbc4f774eabeea94529e",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "--promotion-threshold \"<required improvement>\""
          },
          {
            "sha256": "fc3755c8134dfc6165f6a8df2f2a5fa8a5d0fa0d944d9bd2a6d8f4f8f390b47d",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- do not commit or merge automatically"
          },
          {
            "sha256": "88ceb035f17602476db260dfe45c3b12abd56f04ebb2bbdf2047d19c0569839a",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Escalate beyond this only if:"
          },
          {
            "sha256": "de849f8c38c1f59f48b4c83738174e7746a8b49a4e31d7e288a02b02c22edef5",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Ask targeted setup questions only when missing details would change the result materially. Prefer:"
          },
          {
            "sha256": "935a3e170cab0e88f9ee09569a14412520e631d0bc07d80e2b56f9e605c2d3c2",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- \u201cWhat may change and what must remain frozen?\u201d"
          },
          {
            "sha256": "cfdced873dc492dc584071e7ba4c460c8f61fef991dd0d359b259519ab57c9c9",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- advance the incumbent only on accepted improvement under the declared objective, including permitted equivalent-quality simplicity or efficiency wins"
          },
          {
            "sha256": "602d33e9d3d8d0554c554b3006f1ff6b82389064ed6f359e288d0b7f626f49d2",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "The goal contract must include:"
          },
          {
            "sha256": "23e8dd9759008fcbeda3e62be994bd42200c9254245e562579f72f8916e0d8e3",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- widen only after cheaper checks cannot cleanly separate the likely causes"
          },
          {
            "sha256": "28e960cf0cdd3382419a1f6c48c7208775a4ef2c304da0f9ccea824ddb254daa",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "This ladder is the diagnostic default. An explicit optimization request with sufficient setup can start repeated-trial search; cheaper setup checks do not replace authorized experimentation."
          },
          {
            "sha256": "c4650436ffce6d0080a299222edb1cd9153433b3ebf2b7470a338aa312407a13",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Diagnosis stops once a supported hypothesis explains the behavior and verification passes. Optimization stops at the declared trial limit, time/cost/token budget, verified target, plateau rule, or user interruption. Do not stop optimization merely at the first accepted candidate."
          },
          {
            "sha256": "4760b282f7233ce7b4d3a53ffb7fcb8dc77c6dc923692323594409adb22f007b",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "Define plateau before search (for example, a specified number of distinct unsuccessful mutation hypotheses with stable evaluation). Plateau means no further improvement was found in this bounded search, not that improvement is impossible. Do not consume remaining budget after a declared target or stopping condition is satisfied. A run may finish with the baseline retained, no winner, or inconclusive evidence."
          },
          {
            "sha256": "4004a2cbf3bccbdd20d3b570cce84cdc6e4c338b8cdf82911d689f3262b42fb8",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "A candidate can move forward only if:"
          },
          {
            "sha256": "6a51e4a275ce4da3eab56b997ee51cce195890476ee0d7a088acc407ae5cb8e6",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- use repeated trials only when nondeterminism or conflicting evidence makes them necessary"
          },
          {
            "sha256": "6a60d37d2db2b4a240160c4a63f277c034f8603c0c0677062a97dce67a4de1fc",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- edits allowed only inside the declared scope"
          },
          {
            "sha256": "eb18a93d36edb9f43849cc2d1433bbd6f11e79eb35bff3d7ee45567d6ed0c960",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- do not skip the evidence summary"
          },
          {
            "sha256": "997e76d38a963ceae17f52b84b84e24a6602b7106aebe1103f4fbe2c75ad8af6",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "> Use Auto-Research to improve our code-review prompt so it catches behavioral regressions earlier, but do not increase review noise or operator burden."
          },
          {
            "sha256": "e6a2accd11aa74d653cb70c10f0b8541ced4b72bcf45c4fe393bcfb68801122d",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Do not start search without a measurable goal."
          },
          {
            "sha256": "e311fad67b9caee0439b4a59816bd18c512f894eefcbda5eb64cc50f0b5132f0",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Do not claim a winner from a single run unless the system is strictly deterministic and the user agrees."
          },
          {
            "sha256": "dc68c89c697664553fb7bb48a2659d68a0250be50b9eb600a064de2a8f6ef7c1",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Do not hide regressions inside one aggregate \u201cscore improved\u201d claim."
          },
          {
            "sha256": "2c0d603e8b719a34ac451c0b202160110148690d534e7f6edcf2fd982cbb050a",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Do not assume the host repo allows auto-commit or auto-merge."
          },
          {
            "sha256": "cc9e3e2114b1199c269694682e11f27d6d14d73729e763921cae488ed9136966",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Do not let the capability degrade into generic brainstorming or generic testing advice."
          },
          {
            "sha256": "319afeea172bb09e34ecb56ce56cfc9277817464522c67bea6c3bbebe8d57e91",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Do not confuse public inspiration with local proof."
          },
          {
            "sha256": "34190ff1d43fbaffc4b8e45c4046c8c79e8ffdeda462240094c0510844d63f94",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Do not promote any candidate whose score is ambiguous, unstable, or unrepeatable."
          },
          {
            "sha256": "70468255202b0bc81dac867684bf586ec1c80b51acfa2c62ce60ed6e6e3f03e7",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "- Do not parallelize dependent verification steps when regenerated artifacts are involved."
          },
          {
            "sha256": "b7be70aac455d6397edc44ff9a18a0537779e1c7f99ff7faba82844fdc6e25ac",
            "source": "ssot/engos-optimization-auto-research.md",
            "text": "| Promotion safety | Commit and merge guidance only appear after a verified winner exists |"
          },
          {
            "sha256": "34e6f4ec127393b17e2b24a30972f6cb806b8fd2ab75674628b4e63654bad667",
            "source": "sources/capability-resources/engos-optimization-auto-research/references/resource-delivery.md",
            "text": "Keep shared rules, selected workflow guidance, and required templates available before dependent work. Give independent reviewers the relevant complete contents. Missing, changed, stale, or truncated resources require recovery before proceeding; a filename, hash, self-authored receipt, or an earlier agent's assurance is not a substitute. Never fabricate a run or claim a resource was read without actual supplied content. Resource identity belongs in working evidence, not an invented user-facing verification claim."
          },
          {
            "sha256": "c3bb4c3c49b5503cd85182145a4a39e1fa934cf590fd1914d52028efd9d43c74",
            "source": "sources/capability-resources/engos-optimization-auto-research/references/resource-delivery.md",
            "text": "Template materialization is scaffolding only. Reading or executing bootstrap.py does not run experiments or satisfy promotion. Scope, budget, evaluation integrity, and user/host authority continue to govern all routes."
          },
          {
            "sha256": "62a0df5dab622761e87dff4a143e8ba145f1f2de2090dbf67a87f2d67b3d9f26",
            "source": "sources/capability-resources/engos-optimization-auto-research/templates/goal-contract.md.tmpl",
            "text": "## Must Not Change"
          },
          {
            "sha256": "af03cfd2445c36097789c937c28f7ae04e5a0de97c45306879d93441d5385f58",
            "source": "sources/capability-resources/engos-optimization-auto-research/templates/experiment-ledger.md.tmpl",
            "text": "Dry-run templates contain no executed trial evidence. Retain rejected results and remove only isolated trial-owned active changes."
          },
          {
            "sha256": "09578547eb3051685556941cc2c612a97d9260fc1565f757dab6ea25ba50f769",
            "source": "sources/capability-resources/engos-optimization-auto-research/references/experiment-loop.md",
            "text": "Read this complete resource before an experiment-mode mutation. A dry-run, drafted candidate matrix, or simulated score is not an executed trial. Record actual tools, runtime/model settings, candidate content identity, and evaluator results. If required execution or judging is unavailable, state the limitation instead of fabricating trials."
          },
          {
            "sha256": "739eb25e75870bd9375502eb35ee691f49522a2de8a6ac826c407e16ba35f1b3",
            "source": "sources/capability-resources/engos-optimization-auto-research/references/experiment-loop.md",
            "text": "Preserve three identities: original baseline (immutable reference), incumbent (best accepted state), and trial (isolated candidate derived from the incumbent). Protect evaluator code, evaluation data, scoring rules, limits, and comparison settings from trial edits. Changing the measurement system requires a separately declared experiment; do not improve the score by changing its definition."
          },
          {
            "sha256": "39cf095ea39f8614bc0c9ac214a9e03d2394dcb77687aa1725208903b8051bca",
            "source": "sources/capability-resources/engos-optimization-auto-research/references/experiment-loop.md",
            "text": "3. Execute the protected evaluation on the isolated trial under comparable conditions. Record invalid/crashed trials separately from quality regressions; fix the harness only through its own controlled work, not by disguising a measurement change as a candidate win."
          },
          {
            "sha256": "f9024ca8cd6609851c40e3cd9882920f70aa180f6d00529e7846f8a3990ee766",
            "source": "sources/capability-resources/engos-optimization-auto-research/references/experiment-loop.md",
            "text": "5. Record the decision and evidence before changing state. Discard only rejected trial-owned active changes, retaining its scores, trace references, hypothesis, and useful lesson. Restore the incumbent as the next starting state. Never reset unrelated work or broadly delete evidence."
          },
          {
            "sha256": "1619a4b1efa7acd88b9822fa551d5da94b6451b4ca3a15334ddb2e0739015db1",
            "source": "sources/capability-resources/engos-optimization-auto-research/references/experiment-loop.md",
            "text": "6. Explore again after both wins and losses, using lessons to choose the next hypothesis. Stop only under the agreed trial limit, budget, target, plateau, or user interruption."
          },
          {
            "sha256": "ea2c2d1bb54fe4a7c80da2f71443f08db2cab47b4ba610d309b79ca344ab695f",
            "source": "sources/capability-resources/engos-optimization-auto-research/references/experiment-loop.md",
            "text": "7. Recheck the retained best against the original baseline and required regressions. Report no improvement or inconclusive when justified. Keeping an incumbent is distinct from formal promotion, installation, release, or merge."
          },
          {
            "sha256": "a1a5bd232770d5d0573b5a234e2bb863b42098711932a1295dca82486639efd8",
            "source": "sources/capability-resources/engos-optimization-auto-research/references/experiment-loop.md",
            "text": "Keep candidate generation separate from evaluators and, where judgment is needed, use independent reviewers or qualified scorers. Do not expose held-out evaluation answers to candidate generation. Trial acceptance is provisional to the evaluated scope; claims of transfer require separate evidence."
          },
          {
            "sha256": "8791a4786f39f1650cdfd7c4a177d68fec5817c70ee766a087b1e0e86225f4de",
            "source": "sources/capability-resources/engos-optimization-auto-research/bootstrap.py",
            "text": "parser.add_argument(\"--target\", required=True)"
          },
          {
            "sha256": "94f83b18dddd03eef701151b56f7418498f3b9ac7b5aa87e917a9e3fbb7c3254",
            "source": "sources/capability-resources/engos-optimization-auto-research/bootstrap.py",
            "text": "parser.add_argument(\"--goal\", required=True)"
          },
          {
            "sha256": "80e2eca6e91e2369f66bb0879e5fe1b10903bcb2d48fcd509bd2c6abe1e2022d",
            "source": "sources/capability-resources/engos-optimization-auto-research/bootstrap.py",
            "text": "parser.add_argument(\"--must-not-change\", action=\"append\", default=[])"
          },
          {
            "sha256": "1d5dcb2a9912d866e1485be080033cb0a8a524210b470062b96c42416b706316",
            "source": "sources/capability-resources/engos-optimization-auto-research/bootstrap.py",
            "text": "parser.add_argument(\"--report-dir\", required=True, help=\"Chosen parent directory for stable task artifacts; existing files are preserved.\")"
          }
        ],
        "review_status": "draft"
      },
