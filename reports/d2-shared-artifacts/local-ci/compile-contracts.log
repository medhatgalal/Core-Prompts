            "sha256": "1dff55e0b6a8be5f35a6baad26df7b5b1e3bb1a6d52a6ea0c7575a1c3fa814b3",
            "source": "sources/capability-resources/engos-design-shaping/scripts/handover_outputs.py",
            "text": "# Compare the whole structural inventory, never keyword counts or substring presence."
