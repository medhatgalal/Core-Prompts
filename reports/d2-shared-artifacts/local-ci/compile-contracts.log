          {
            "sha256": "ea44296848e772725953d544c8268aa881ed79923530d9d2eae8b2e38a3cd98d",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"required\": [\"schema_version\", \"work_order_id\", \"gate\", \"author\", \"reviewer\", \"inputs\", \"source_revision\", \"resource_revision\", \"skill_allowlist\", \"original_constraints\", \"assigned_questions\", \"source_access_scope\", \"effort_bound\", \"stop_conditions\"],"
          },
          {
            "sha256": "dca35e71001f6ea3019c81aec6804441efd3ea6c0806fbcfaf8e885117dc662c",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"accepted_proof\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"text\", \"source\"], \"properties\": {\"text\": {\"$ref\": \"#/definitions/text\"}, \"source\": {\"$ref\": \"#/definitions/sourceQuote\"}}, \"description\": \"Controller designates exact accepted proof and G2-owned source; reviewer judges acceptance and meaning.\"},"
          },
          {
            "sha256": "3a5702fb483dac4e90d01d74054bb9b3c64470d98c9c97a7ed25da9abdfcb618",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"participation_evidence\": {\"$ref\": \"#/definitions/path\", \"description\": \"Required hashed host stable-ID/consent participation input for opt-in G3.\"},"
          },
          {
            "sha256": "b4d0c5e992aaf9fcb3355006b0dad21b949b62adf8f3c0e42a8009b104d88d44",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"description\": \"Required by runtime for G3 under shaping_loop=true; every span must be covered by accepted G2 research-coverage.json.\"}"
          },
          {
            "sha256": "c0ea9a1ab6363f2ee5dc6fda0e499a2d575449575f5686db5abdf9fa74b6bea2",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"required\": [\"id\", \"blocking\", \"in_scope\", \"status\", \"evidence_standard\", \"evidence\", \"decision_id\", \"dependency_evidence\"],"
          },
          {
            "sha256": "a716fb56447ed70d5c7696d766882b01861cc26471e98cd658ac02decfa91554",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"description\": \"G2 onward in-scope blockers must be answered with evidence. Exclusion requires in_scope=false, status=excluded, confirmed decision and dependency evidence. IDs cannot disappear or downgrade blocking.\""
          },
          {
            "sha256": "9ab4c03988464536c1a1f2c818fb315732e538b4d8ada4cc4857b7db0783bb8f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"id\", \"status\", \"authority\", \"reason\", \"evidence\"],"
          },
          {
            "sha256": "efc52be16db61998e24694d288b80980a507c8b2942bd3a49be34d2510155e08",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"outcome\", \"evidence_ids\", \"explanation\"],"
          },
          {
            "sha256": "6e9ad297dfff65540f3d9fdc08e3bf62642a1e85927f5ec9e9ae82973e707f96",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"description\": \"Acceptance requires pass for every policy predicate. This is an actual reviewer assessment, never author keyword scoring.\""
          },
          {
            "sha256": "42fc2d896ab16d57c9ee852567491730604d341eaa124ad6eed54246afe48b6c",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"score\", \"rationale\", \"evidence_ids\"],"
          },
          {
            "sha256": "7967581eafbb49f7e30743e7f82b267e44b704ca704a67709600a30f366269ef",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"dimensions\", \"team_mean\", \"pitch_mean\", \"overall\"],"
          },
          {
            "sha256": "fc34566e227a9dfcc4c95f76825909e2c992b885ac6149dd7cf4f66e3a51ef6f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"required\": [\"simplicity\", \"testability\", \"security\", \"architecture\", \"cost\", \"feasibility\", \"confidence\", \"problem_clarity\", \"appetite_fit\", \"solution_sharpness\", \"contract_quality\", \"boundary_discipline\"],"
          },
          {
            "sha256": "21698734d1077d84703ec86790217a8349fcba0eaf0feb49ef3af564ab085658",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"description\": \"All twelve scores >=3; overall >=4. Overall=sum(all twelve scores)/12, checked to absolute tolerance 1e-9. Category means are reporting only. Use source-specific rubric anchors; no generic all-5 implementation rule.\""
          },
          {
            "sha256": "b7a8364270c42ee7e98f9d0030b7a2769ed279d419637620d7d6c06561b303e4",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"operation_id\", \"readback\", \"inventory\"],"
          },
          {
            "sha256": "061a527ee06de0baad773d4ea25caad3ffa470b592f887c0143a29b11affb783",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"oneOf\": [{\"required\": [\"pixels\"], \"not\": {\"required\": [\"structured\"]}}, {\"required\": [\"structured\"], \"not\": {\"required\": [\"pixels\"]}}],"
          },
          {
            "sha256": "29f84561162adab7debb150fc0a0315042f9b27b4d0a76e387f080a55e8f0c2f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"required\": [\"schema_version\", \"run_id\", \"gate\", \"work_order_id\", \"generation\", \"policy_hash\", \"resource_revision\", \"predecessor\", \"return_hash\", \"subject\", \"reviewer\", \"authored_candidate\", \"independence_confirmed\", \"evidence\", \"assessments\", \"findings\", \"unresolved_blockers\", \"verdict\", \"next_state\", \"scores\", \"render_evidence\", \"targets\"],"
          },
          {
            "sha256": "59965fc9ea6ad7868c392af7dc38c2301915d14469bcf8890fa17917100651b7",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"then\": {\"properties\": {\"scores\": {\"$ref\": \"#/definitions/scores\"}, \"render_evidence\": {\"required\": [\"component.mmd\", \"sequence.mmd\", \"data-flow.mmd\"]}}},"
          },
          {
            "sha256": "2866078e8b9241a31657fbe3358814f579e16b929f6ccc39dfa5b97c91cde2ab",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"status\", \"note\"],"
          },
          {
            "sha256": "9672a438136b8397897f3c29afa405b0a6efccbdfcdd4dbad43afe1344c4b8c9",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"readback\", \"inventory\"],"
          },
          {
