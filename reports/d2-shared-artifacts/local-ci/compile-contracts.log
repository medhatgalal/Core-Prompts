            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
            "text": "\"reviewV2\": {\"type\": \"object\",\"additionalProperties\": false,\"required\": [\"schema_version\",\"run_id\",\"gate\",\"work_order_id\",\"generation\",\"policy_hash\",\"resource_revision\",\"predecessor\",\"return_hash\",\"subject\",\"reviewer\",\"authored_candidate\",\"independence_confirmed\",\"evidence\",\"assessments\",\"findings\",\"unresolved_blockers\",\"verdict\",\"next_state\",\"scores\",\"render_evidence\",\"targets\",\"review_evidence\"],\"properties\": {\"schema_version\": {\"type\": \"integer\",\"const\": 2},\"run_id\": {\"$ref\": \"#/definitions/id\"},\"gate\": {\"const\": \"G3\"},\"work_order_id\": {\"$ref\": \"#/definitions/id\"},\"generation\": {\"type\": \"integer\",\"minimum\": 0},\"policy_hash\": {\"$ref\": \"#/definitions/hash\"},\"resource_revision\": {\"$ref\": \"#/definitions/text\"},\"predecessor\": {\"oneOf\": [{\"$ref\": \"#/definitions/hash\"},{\"type\": \"null\"}]},\"return_hash\": {\"$ref\": \"#/definitions/hash\"},\"subject\": {\"type\": \"object\",\"minProperties\": 1,\"additionalProperties\": {\"$ref\": \"#/definitions/hash\"}},\"reviewer\": {\"$ref\": \"#/definitions/text\"},\"authored_candidate\": {\"type\": \"boolean\"},\"independence_confirmed\": {\"type\": \"boolean\"},\"evidence\": {\"type\": \"object\",\"minProperties\": 1,\"propertyNames\": {\"$ref\": \"#/definitions/id\"},\"additionalProperties\": {\"$ref\": \"#/definitions/path\"}},\"assessments\": {\"type\": \"object\",\"minProperties\": 1,\"additionalProperties\": {\"$ref\": \"#/definitions/assessment\"}},\"findings\": {\"type\": \"array\",\"items\": {\"$ref\": \"#/definitions/typedFinding\"}},\"unresolved_blockers\": {\"$ref\": \"#/definitions/texts\"},\"verdict\": {\"enum\": [\"pass\",\"fail\",\"unverifiable\"]},\"next_state\": {\"const\": \"G3\"},\"scores\": {\"oneOf\": [{\"$ref\": \"#/definitions/scores\"},{\"type\": \"null\"}]},\"render_evidence\": {\"type\": \"object\",\"additionalProperties\": false,\"properties\": {\"component.mmd\": {\"$ref\": \"#/definitions/refs\"},\"sequence.mmd\": {\"$ref\": \"#/definitions/refs\"},\"data-flow.mmd\": {\"$ref\": \"#/definitions/refs\"}},\"required\": []},\"targets\": {\"type\": \"array\",\"items\": {\"$ref\": \"#/definitions/targetReview\"}},\"review_evidence\": {\"$ref\": \"#/definitions/reviewEvidence\"}},\"allOf\": [{\"if\": {\"properties\": {\"gate\": {\"const\": \"G3\"}}},\"then\": {\"properties\": {\"scores\": {\"$ref\": \"#/definitions/scores\"},\"render_evidence\": {\"required\": [\"component.mmd\",\"sequence.mmd\",\"data-flow.mmd\"]}}},\"else\": {\"properties\": {\"scores\": {\"type\": \"null\"},\"render_evidence\": {\"maxProperties\": 0}}}},{\"if\": {\"properties\": {\"gate\": {\"const\": \"G4\"}}},\"then\": {\"properties\": {\"targets\": {\"minItems\": 1}}},\"else\": {\"properties\": {\"targets\": {\"maxItems\": 0}}}},{\"if\": {\"properties\": {\"verdict\": {\"const\": \"pass\"}}},\"then\": {\"properties\": {\"render_evidence\": {\"required\": [\"component.mmd\",\"sequence.mmd\",\"data-flow.mmd\"]}}}}]},"
