          "f22c32a7ac824db3bf31aed9188c53b4ba9e7018bc4c6cd224dd284c17766e47",
          "d77a4ab481333059a0f06a468ef8b2313ab6442d62fc3fb61264cf447ec521fc",
          "d843560debc916a96d63e774ead3fa0c6f047e3c7a11ed7cb68d997455105226",
          "f61824e36f85ac18822d62608011c372eed3accebce12831b5c24a3fcfef4cb5",
          "530e7995cd6dc8ec8093f452a51e0faf660b809b249f4fb485c7cfa97c16695d",
          "2440ae1c66124044ee83d601c0a2608e5a9bf458bd70006f3392a8628e2e9843",
          "4a7f013c1245859d67ab16048a675ec0e81d17d9a6298bd97039ab0eac934c6d",
          "8ea78236f3ba0076108149f1554bb8b2b61cea3a4b7fed66475a7b8b9e84ee0a"
        ],
        "editable_behavior": [],
        "primary_outcome": {
          "metric": "skill_specific_task_success",
          "definition": "Correct routing, canonical stack order, module preservation, explicit-only behavior, state transitions, output-contract adherence, and improved downstream artifacts.",
          "threshold": "human_review_required"
        },
        "secondary_outcomes": [],
        "regression_limits": {
          "protected_binary_margin": 0.02,
          "critical_deterministic": "exact_pass"
        },
        "cost_latency_limits": {
          "profile_caps": {
            "static": 0,
            "native": 0,
            "routing-canary": 300000,
            "canary": 1250000,
            "promotion": 5000000,
            "cross-host": 12000000,
            "sweep": 30000000
          }
        },
        "runtime_envelope": {
          "required_cells": [
            "anchor"
          ],
          "cross_host_required_for_pilot": false,
          "status": "unresolved"
        },
        "promotion_rule": "Change-class-specific proof plus all hard gates; no aggregate compensation.",
        "rollback_trigger": "Any protected regression or stale bound evidence.",
        "source_clause_hashes": [
          {
            "sha256": "fabe5afaba321510d9cbbba60a99c553f22b891bd49c863c1b4fbd79f9e47cef",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- forbidden: hidden chain-of-thought exposure, fake certainty, claiming runtime orchestration ownership, or destructive execution without explicit approval"
          },
          {
            "sha256": "c9500a0c7e4a5345230103ae2546507f5326f4316f994387e2a59962f01e895b",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "Keep candidate identities and review evidence inspectable in the conversation, a single working ledger, or temporary task storage as needed. Do not create report directories or files merely because a module ran. Preserve unrelated files and never load historical outputs as skill instructions."
          },
          {
            "sha256": "77357dbdaba34183181a2940a8cdce735aae457d5f4694b620c0fe81799c73b6",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "## Required Inputs"
          },
          {
            "sha256": "2122acceb06bd4b1bf7417ac3a53e769e73054d9f4cdda4e919cdf602424d6b0",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- any sources or alternatives that must be compared"
          },
          {
            "sha256": "3d4b9f171064970a2e9947e6e3f0fb13501d9ced9a9ac9ebe2cde123882829ec",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "## Required Output"
          },
          {
            "sha256": "462e9be0d37f75775aa7ed83727f4dcb0fd9230c0bc97de76e74570491f5235a",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- Do not stack heavy frameworks concurrently without reason."
          },
          {
            "sha256": "a2f7f47b666b82ba7c10897612176fbd0471d4fca921c95c12e2b5a4278d7dbc",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- Do not bloat the answer with every module when a smaller route is enough."
          },
          {
            "sha256": "153f329d96f6adbcea8f255559fb58d818927fab0b7f0676abe34aa0d479a1e3",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- Do not pretend the model knows user preferences it has not been given."
          },
          {
            "sha256": "8c515a3b2167ad8b14392932b090365fbbd89fd5f6de946ca68b9db950635dd1",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- Do not turn grading into generic praise."
          },
          {
            "sha256": "545f9a6e85822fd1000e368d4be8314acb21a3f44d7d1de6924d286e798959d8",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "Treat `supercharge` and `/supercharge` as conversational aliases for this capability. Normalize only the leading capability name to `engos-meta-supercharge`; preserve every following module, modifier, argument, and their order. Apply the same help, examples, details, stacking, and terminal-control precedence to all four forms. For example, `Supercharge /full` and `supercharge /simple /invert /contract <task>` retain their existing meaning."
          },
          {
            "sha256": "00c44be77b36c3bc11d8fab0ab48af55b0a164f8918881767f9bd509b73d2ca8",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "These aliases are instructions within this one canonical skill and agent. They do not register native CLI menu aliases or emit separate short-name packages; use the full namespaced name for explicit skill selection."
          },
          {
            "sha256": "084b828b0f657abc4e698fe7606bc3516d294be734e8ac16c8f0ecfd870dda10",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "If the user asks for help, respond with the `HELP OUTPUT` section only:"
          },
          {
            "sha256": "de5efcdb1dddd453ec5759a260623c1a73c12770bb439b233916be1ed95fca61",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "If the user asks for examples, respond with the `HELP EXAMPLES OUTPUT` section only:"
          },
          {
            "sha256": "e3aaf81fa3ff36a0e1f4c1101a863e1995a462a9d0114659c5a0384bab583c7e",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "If the user asks for details, respond with the `MODULE REFERENCE` section only:"
          },
          {
            "sha256": "21ed843d566710b5fa91b075345eaaa8f4d14a5e1e946685852105908fda6941",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "2. Help, examples, and details are terminal when `/stop-ult` is absent; return the one matching section and do not execute examples or modules."
          },
          {
            "sha256": "bb8d4adb2da1ea83b3e589293f9416536b0a299328e4d2481f82abe21f053ec8",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "3. If more than one help, examples, or details control appears, ask the user to choose one instead of combining section-only outputs."
          },
          {
            "sha256": "8c1ae20069e89963464c29a0712934709cc957a0f0a827363cc392066e60b86c",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "If multiple commands appear, SuperCharge MUST treat them as a stack and execute them as a multi-pass sequence."
          },
          {
            "sha256": "1853e84b2bca0eca1146342971f5af087edb4b71146959543ed688f95377268e",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "If `/route` appears anywhere in the invocation, SuperCharge MUST print exactly one line first:"
          },
          {
            "sha256": "bb919709e8475a0b190580085a5e756421b6c5d71ccedfd656c43937fdf314bf",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- Never invent facts. If critical info is missing:"
          },
          {
            "sha256": "f2dc3f65db6864bfc8c5148e6b50bc667f6dffa6cfebd282888e4d7c8143d8c8",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- Never apply heavy frameworks concurrently. Use multi-pass filtering."
          },
          {
            "sha256": "ce5c039dec20d4d1169775f9c5aeaf326e57fc5bc591d397d5138579f3d3a97d",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- Never request or expose chain-of-thought."
          },
          {
            "sha256": "40fe8df0772281c18d64440e34f0c832d9a8c151e2ef9ef243f761899fb25c96",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "Use questions only when missing info would materially change the outcome."
          },
          {
            "sha256": "acb40e65d1130f718356e57c91b7cdd5bcf7dd0cde152797b428fbd6b926af95",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "Never pretend to be the user or answer for them."
          },
          {
            "sha256": "fb53dd951133fba280145290c1b7985b0a1933a53cbefbdefe466adaac9dd11c",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "If the user provides no explicit module, SuperCharge MUST route the request to a sensible sequence and announce it:"
          },
          {
            "sha256": "832fa678350d1dfbe163d15f2ae27c89f08d1d119a5a4400410df238193f98e8",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "If the user supplies more than one reflective control, stop and ask them to choose one; do not silently select, merge, or discard controls. Auto-routing must not add `/safe` when the user supplied another reflective control. Safety constraints still apply regardless of modifier choice."
          },
          {
            "sha256": "cf9a08cacbfdfe05220a4090072404d660f534d90298a402c649cd527c890558",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "Actual independent subagents are mandatory for substantive improvement, review, grading, and verification. Self-review and simulated agent roles are not acceptable substitutes. Recover failed delegation or report required review as incomplete; never claim it passed. Help, example listing, and mode exit are exempt."
          },
          {
            "sha256": "3dde2d8c29aff165982054544e0ef311b03e95b39daf8209bbdf94b160afab9d",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "Initial reviewers receive the task, criteria, evidence, full required module resources, and artifact without the author's self-grade or preferred verdict. Preserve necessary factual context. Exchange findings afterward for debate and synthesis. The author cannot approve its own work. Detailed coordination rules are in `resources/references/shared-review.md` and are a dependency of operational routes."
          },
          {
            "sha256": "135a5be3cdc7446bc11536bc4d2a162de614736bef72a90cad9d35edf2267250",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "For skill surfaces, resolve paths relative to the skill directory. For agent surfaces, resource-map paths resolve relative to the directory containing the bundled `capability.json`. The map uses paths without the `resources/` prefix. Use `python3 \"<resource-root>/scripts/load_module.py\" --route /ult --format text` with the selected exact route (repeat for stacked routes) when the bundled helper is available. `<resource-root>` is the skill's `resources` directory or the agent resource directory containing `capability.json`. The loader must emit the full selected payload; but a filename, search result, hash, truncated excerpt, or self-authored \"read\" receipt is not delivery evidence. Supply each subagent the complete relevant resources and preserve tool or host delivery evidence."
          },
          {
            "sha256": "01bab8d2672760842d0a6f540634b25f3504968a7940276be5a243b2deb053d6",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "If a required resource is missing, stale, changed during execution, or incompletely delivered, recover it before dependent work. Do not guess its contents or silently shorten the route. Delivery does not prove comprehension; independent checks must use behavior that depends on the resource. Do not claim host enforcement unless a verified host actually supplies it."
          },
          {
            "sha256": "2c2a3cd3d57153892d544391edc59cda90e526955ecccfa6d1696bb4d257339a",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- do not claim that the route is unsupported"
          },
          {
            "sha256": "6c7c3fc931a09bd50661b58e0b4bdacfc021616f24c8e2cdac239c133f7058c3",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- do not substitute a generic response, a shortened route, or another module"
          },
          {
            "sha256": "3d574abfbdc7e45dcd3cf8aa317e1d124b3f2f81f83a0d06c5fc1ed4e1c01dc7",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- do not execute the requested route until the resource is recovered and rechecked"
          },
          {
            "sha256": "4c695efce4a93f80586c41a7222a97f652812bddd20a0e9489bfdf744ff8ba54",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "Terminal help/examples/details and `/gaslight list` or `/gaslight help` return only their specified output. `/catchup` retains its exact tables and validation text, without generic wrapper sections. `/contract` retains `Contract Spec` and its exact QA JSON schema; when the user explicitly requests JSON-only, return only that JSON with missing context or gaps represented in its existing fields. Other stacks retain canonical pass order and module output shapes under the general wrapper; `/full` supplies its own pass wrappers. `/ult /full` does not execute the generated task and says so explicitly. No precedence rule permits fabricated results or skipping independent review."
          },
          {
            "sha256": "1f2f66d251cf2341cfc491f9858cf5894c47d33e810a06a3d1c77e3e3284b4ce",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- Only run capstone when a deliverable is complete or the user says done, ship, or finish."
          },
          {
            "sha256": "0f7011d4f63204ffbe768e8ca1563c9c913aaa43b10d7b02b88e54f85e37be3f",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- Do not run capstone after small replies."
          },
          {
            "sha256": "811378a9f2b4cead606e14ff92a39523941643cb6b2fc9e91636c264d9de7ef0",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "- The capstone uses the `/catchup` resource-delivery gate. If that route cannot be loaded, report the delivery block and do not append an improvised or generic catch-up."
          },
          {
            "sha256": "bf84a9ca15a8049a88b6c106a56714ead4283e4e414046ba35c5e9a4d79d9a96",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "For a terminal help request, load route `help` from the resource map and read `resources/references/help.md` and return its help content only. Do not execute its examples or continue into an operational module."
          },
          {
            "sha256": "bd45ef1c4189a860f61d205742bac16d6b82f46864747e88ce7eca12b7585427",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "For a terminal help-examples request, load route `examples` and read `resources/references/help-examples.md` and follow its exact example-generation and output contract. Do not execute the examples."
          },
          {
            "sha256": "bc6e78faf2d2f8a6f485af354eff43935a788e688825b2e17fdfd55c77156d0d",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "For a skill surface, these paths are relative to the skill directory. For an agent surface, resolve `references/help.md` and `references/help-examples.md` relative to the directory containing its bundled `capability.json`. If a required help resource is unavailable, report the missing resource instead of inventing or silently shortening the help contract."
          },
          {
            "sha256": "1086282a839e815707d3b9b3c2aa3111e41ed792875b654e67c2d580189747dc",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "For `/details`, load route `details` and return the complete module resources in their declared order below. Do not return this routing table in place of the full specification. Do not execute listed modules or examples."
          },
          {
            "sha256": "574ba4b9ebaede6d38ab6dd32e90ffe5119fa403bd711d9a7f799c51ae4185b4",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "| Route | Required module resource | Purpose |"
          },
          {
            "sha256": "8d803f12c5325162c8bcea53165f67d1c6e253093b36f160233642f2db53eb15",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "| `/adversarial`, `/debate`, `/debate /deep` | `resources/references/modules/adversarial.md` | Attack or independent Bull/Bear/Decider council; `/deep` is valid only with `/debate` |"
          },
          {
            "sha256": "8f31056600efa04e5b57f9bd6a7096ebfb3abaa833636e6d36085800538b7cd0",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "| `/gaslight` | `resources/references/modules/gaslight.md` | All 13 IDs, 1\u20133 selected techniques, explicit-only experimental framing |"
          },
          {
            "sha256": "fe096be639aba6e4fa117dff16ecd8c40f0788ec7f3a49798a59bcccb78b9ee3",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "| `/stop-ult` | `resources/references/modules/stop-ult.md` | Exit ULT mode only |"
          },
          {
            "sha256": "feaefefe17465fe21316d214e11d8564f8096e6419fccd8a5be4f804c20c8057",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "Optional model-adaptation resource: `resources/references/model-guidance.md` (route `model-guidance`). Use its single research-only refresh workflow monthly or on new model/guidance triggers; it never silently edits skills."
          },
          {
            "sha256": "d64ae5a71161e0cf76d03b7bd2822eef3365c186603302e3864a9ef7e23c0d55",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "Produce real candidates and independent grades, retain the best, and show only actual trials under the unchanged four-section output format."
          },
          {
            "sha256": "92b53a938b793f5527e146dcd6bf532abf854a4b24140d197f0d37785801edc1",
            "source": "ssot/engos-meta-supercharge.md",
            "text": "| Boundaries | User scope and host authority govern execution; `/full` never executes its generated task |"
          },
          {
            "sha256": "7ddb52414079c0d18155d68055abb4ab8d6bfc3311476d25e1afd4688bdcf730",
            "source": "sources/capability-resources/engos-meta-supercharge/references/shared-review.md",
            "text": "For substantive improvement, review, grading, and verification, use actual independent subagents. Do not simulate agents, substitute self-review, or let the author approve its own artifact. If delegation fails, attempt recovery within the available runtime; otherwise mark the required review incomplete and do not claim completion. Routine help, examples, command listing, and mode exit need no reviewer."
          },
          {
            "sha256": "409e75d005920af2443219af35db05168ddbdd17b213ba457480ba4008705b1b",
            "source": "sources/capability-resources/engos-meta-supercharge/references/shared-review.md",
            "text": "Give each reviewer the original task, full factual context, constraints, stable criteria, relevant resource content, and candidate artifact. For its first assessment withhold the author's self-grade and preferred verdict and other reviewers' initial conclusions. Do not withhold facts necessary for fairness. Exchange findings after independent assessment where debate or reconciliation calls for it. Preserve material dissent and resolve findings with evidence rather than voting alone."
          },
          {
            "sha256": "6ee469de75a999c152cb079765db0564c39755f10fa08435fa25533dc352aa1c",
            "source": "sources/capability-resources/engos-meta-supercharge/references/shared-review.md",
            "text": "Discover the available subagent interface; use the default configured model unless instructed otherwise. Subagents may share model biases, so separate contexts reduce anchoring but do not prove independence of all error sources. Reuse an agent for related follow-up when the module's initial independence is preserved. Parallelize independent work; sequence dependent passes and synthesis."
          },
          {
            "sha256": "7751526a753b2c27d611f0bb07f0b63d2c0052ddf043c43d2d03b55e55316205",
            "source": "sources/capability-resources/engos-meta-supercharge/references/shared-review.md",
            "text": "The resource map describes route dependencies. Missing, stale, changed mid-run, or partially delivered dependencies block the affected module until recovered; never invent the missing contract. A changed resource requires reloading and rechecking dependent work. On hosts without automatic assembly, observable full file reads are required. Tool evidence proves delivery, not comprehension; independent resource-dependent behavior checks assess compliance. Never claim mechanical enforcement where only instructions are available."
          },
          {
            "sha256": "2864c372b0d5618f6bb5b918f55cc8a98efb56b00678d8858cac44f748bfcd86",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/ult.md",
            "text": "- Target material improvement in reasoning, completeness, usability, reliability, or meaningful efficiency. Cosmetic edits alone are insufficient. Report a percentage only when a defined metric, baseline, and comparison support it; otherwise describe the substantive delta and remaining uncertainty. Retain the original when proposed changes do not help."
          },
          {
            "sha256": "ce6961476a4e9e7676627a9acb5877842d40c19a18379b1f773a23eb3ea2f40e",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/ult.md",
            "text": "- Never require or expose chain-of-thought."
          },
          {
            "sha256": "6e17b06dd6f71cf8d58738d54e84ad75005704d518b1180702036e034676142d",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/ult.md",
            "text": "2. Display the improved prompt and state briefly that execution follows, then run it within the user's authorized scope. Do not ask again for already authorized work."
          },
          {
            "sha256": "4c086a67af3234fe9f27e0ebbedd44b872f5ed2c4f8b8c69a4a9f8419b68a098",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/ult.md",
            "text": "3. Explicit draft-only or review-only requests suppress execution. Ask only when a material decision or missing authority prevents authorized execution. Generated instructions do not grant new authority."
          },
          {
            "sha256": "8b00a5c5e381665565cf315c900a95ab090b672033fcbd896a7cf23e0227f370",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/ult.md",
            "text": "A demonstration is evidence about that run, not measured superiority across tasks. Route behavioral comparison to Auto-Research when required."
          },
          {
            "sha256": "0fce815130135c0c5743295967f64cb29cc1fcc9282b19bcc6a22d6342ade716",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/catchup.md",
            "text": "- Reconstruction only. Do not propose new solutions."
          },
          {
            "sha256": "420f6fefd3529cb047e47f3d61d5c067824bd35a61d16acd83fcac8cbb3e07a5",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/catchup.md",
            "text": "- Do not invent missing info; label unknowns as `[Unclear]`."
          },
          {
            "sha256": "2a1e26e97cd5a7a6c447a9823f6df78273b6ba0b8c236edcef42f28e559ee16c",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/catchup.md",
            "text": "`/catchup` is a supported SuperCharge route. When this module is delivered, use its exact table and validation contract below. If delivery fails, follow the SSOT `Resource Delivery Failure (Fail Closed)` rule; never reinterpret `/catchup` as an unsupported command or a generic catch-up request."
          },
          {
            "sha256": "44413d93afe2b69cf124a53541db57ac97d5866167be733d05cf93f11c65420e",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/catchup.md",
            "text": "Keep evidence collection details in working records. Do not turn the table into a source-log dump. `Next Steps` contains recorded commitments, not a new plan; if fewer than 3\u20135 are recorded, say so in that cell instead of inventing actions. Preserve all rows and visible validation checks."
          },
          {
            "sha256": "f3a3aecb6094efc3a122d10c2a55818e9705dca69dd892a34abcc24fb8ed53ad",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/catchup.md",
            "text": "1) Reconstruction only (no new solution)"
          },
          {
            "sha256": "8ddc2b232a74d1498b493d3ebf26238140b14d1f3c777f3839a2399078b612af",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "Reconstruct a problem from the required outcome, supported facts, binding constraints, and explicitly identified assumptions. Challenge what is actually necessary, then derive the simplest sufficient approach without losing sophistication, capability, quality, or legitimate safeguards. Cost accounting is one application, not the definition of this lens."
          },
          {
            "sha256": "332d859e79d5a3c2487daf62f07c02c151371f56d9f53b72b00dc37791f3d177",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "- Do not pretend the irreducible minimum is known when inputs are missing."
          },
          {
            "sha256": "340145caa900fb88faecefd2d1fd16d550261129d0d1ed7acfd768bf916ac081",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "- Do not optimize by deleting necessary quality, safety, or review gates."
          },
          {
            "sha256": "1654795fd8fca146389fc2a376de8d2f7a771d5e19d48a9ccfee29af15686cff",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "- Do not use celebrity branding or personality imitation; use the model as a reasoning lens."
          },
          {
            "sha256": "ae8eac474e3bdc8bb8b755c048076334098a5e424a7a797feed4bb6e25303f12",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "- Identify primitives: required inputs, outputs, constraints, physics, data, user value, safety requirements, or repo policy."
          },
          {
            "sha256": "43857031ee69d682588b7d4de6df8cfa42959fa4d5bb0e3c84f145e3f2a72f21",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "- Estimate a minimum only where defensible: cost, complexity, latency, token budget, file count, process steps, or review load. Under `Theoretical Minimum`, describe a qualitative sufficient design or state unknown when no numerical minimum can be justified."
          },
          {
            "sha256": "30431a03e1463da26ee70526d211b93a089d6647acb4e5991b1a22de9c342d06",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "- Compute `Actual-to-Minimum Ratio` only when both quantities have defensible units and evidence. Otherwise state not applicable or unknown and identify what would make comparison meaningful; do not invent a ratio or categorical estimate."
          },
          {
            "sha256": "118082c67242fbffdf0a4eb949da2c36148dc19ea043a296deee7d9444d9d977",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "- Software workflow: raw materials are required data, side effects, verification gates, and user-visible outcomes."
          },
          {
            "sha256": "2c5b0eaf033290001570ee07c605c226156e6f04003fc78ba0f452c5e5d2ff63",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "After: Map the irreducible quality requirement, measure the added operator burden, remove modules that duplicate `/simple` or `/contract`, and route only unproven behavioral claims to `engos-optimization-auto-research`."
          },
          {
            "sha256": "2d76c7503fac2604dc4287bb9f1b843fdcd3bf78085717639da4ba859498673f",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/basis.md",
            "text": "After: Identify the required decisions and evidence, collapse duplicate status reporting, and keep only the review gates that protect irreversible risk."
          },
          {
            "sha256": "de983b0bf7f169bb0e44a79ced4ece9e1c4e2dbbc3fe83b8a40a8e9d425e6ccf",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/simple.md",
            "text": "- Do not equate fewer parts with simplicity."
          },
          {
            "sha256": "3218e87fa36d65171fc87a35021b89e61144b905ca0d1b6f544c736cb97de62b",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/simple.md",
            "text": "- Distinguish MUST / MUST NOT invariants from PREFER guidance. Do not silently weaken requirements or promote preferences into obligations."
          },
          {
            "sha256": "1cfa4817b59fd904e10ab50bc8e8382150f0bb819bf19b62715e21d6324df657",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/simple.md",
            "text": "- Validate invariants as well as outputs: retained guarantees, side-effect boundaries, and failure behavior must still hold after decomplecting."
          },
          {
            "sha256": "5e22a8341d2aac3a8e34cff1e72a4e0e98c1391dd74d257615e340dbe4200802",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/simple.md",
            "text": "- Steps that only work in a specific order without explanation"
          },
          {
            "sha256": "7220cd33089d4650f8ec821f85864fc0e2da5d3d683d55fc3f67ed4ec64e8c4f",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/simple.md",
            "text": "The response MUST include 1\u20132 worked examples tailored to the user's domain. Only when the domain is unknown, include one general example. The reference examples below do not substitute for tailoring at runtime."
          },
          {
            "sha256": "a0f227a8abf1f95e88cfb4acada7f3ea1e1e092ef79d4c95c14adc306f771bc4",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/invert.md",
            "text": "- Define the outcome to avoid and derive plausible causal paths toward it before producing the guarded forward solution. Prioritize material paths; do not manufacture a fixed count of defects."
          },
          {
            "sha256": "7a85c0c5e59975c623e10bd33d33ec5c8eb6acfe1bfad3e61167797356242742",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/invert.md",
            "text": "- Translate the analysis into prevention, detection, and recovery. A forward claim survives only to the extent the evidence supports it; missing observation is not proof of safety."
          },
          {
            "sha256": "727b4857bc88f11555243e5d7113bf668f765d540865550d8b5a7662d9060a73",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "- \"No material issue found\" is a valid result after investigation. Every finding identifies an affected assumption or behavior, its evidence or explicit uncertainty, and its consequence; do not invent defects to fill the format."
          },
          {
            "sha256": "e85ce71b7d7500eed5681ebb61ae48cc44efabfcfdd220953b2b4469fec64efe",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "- Do not rewrite the entire artifact unless asked; critique and fixes first."
          },
          {
            "sha256": "982f90daeea8f56b1576db77e81e9e68cacad5ee4f5b4e82488e8f3167006b9f",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "- Do not invent facts, cite unavailable evidence, or present stale market knowledge as current."
          },
          {
            "sha256": "6f56e36cddda69ad518ba192294b73281d0592c049b9e9e0f60613337dfebed2",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "- Do not claim that debate proves behavioral superiority; route proof requests to `engos-optimization-auto-research`."
          },
          {
            "sha256": "e37b5b246d0d0bc7d209bda3cda2c83d148b67331cfabc2e4af8dccb81b55af6",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "Council independence: separate Bull and Bear subagents form initial positions from the same factual packet without the author's preferred verdict or each other's initial answer. Only then exchange arguments. A separate Decider adjudicates using evidence, can reject both positions, or retain uncertainty. `Confidence: 0-100` is a judgment estimate unless empirically calibrated, not a probability guarantee."
          },
          {
            "sha256": "3e05f458839794784cdc854cf9af999892319026fa1977e0c988d960a9a65a64",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "- `/deep` is scoped to `/debate` only. Do not treat it as a global modifier for unrelated modules."
          },
          {
            "sha256": "3b48bf890ca32cfe16f732e24708802403cb46b977f4cc295c15271e491d34e1",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "- Bull and Bear first form independent assessments; preserve their initial records before exchanging the documented rebuttal rounds. Bull and Bear must engage each other's strongest points rather than producing parallel essays."
          },
          {
            "sha256": "f2d7254302ac3e7bbbd4b56f198da899eca2e4e310b2d400ddd4da86001ceb65",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "- Use a separate Decider; it may reject both positions or specify the evidence required to break a tie. Label confidence as judgment unless calibrated. The lead agent must not impersonate the council."
          },
          {
            "sha256": "0584cae1101b9d2ed88540c791d7fce03cf52fb15bd976e10cb9b5bd1aed522e",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "- Decider must state what evidence would change the verdict."
          },
          {
            "sha256": "e8fbf812d5ea392cdf3609e80c955c8f14d7a0d4ce85aca19d96021a2bc86b77",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/adversarial.md",
            "text": "4. `Bull Counter` \u2014 answers only the strongest Bear objections"
          },
          {
            "sha256": "588ae2f2dee72419f29e6728e51f55d70ab36bdf171b2c6f0233a5a16f0782f8",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/contract.md",
            "text": "- Do not invent context or silently turn proposed criteria into user requirements."
          },
          {
            "sha256": "2e49bd3d2a315f77512163af79b85fdfba58314248fd2c906709eb0b0e019a33",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/contract.md",
            "text": "- Version the contract before review. If a criterion is defective, record the revision and re-evaluate; do not move the criteria merely to fit the artifact."
          },
          {
            "sha256": "eb0b04afd5182d676aa5736dabffa3438c80899fce1b2eaedfe454e1cc8b5e8d",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/contract.md",
            "text": "- The checker receives the contract and artifact without the author's desired score. A contract already sufficient for the task is a valid result; identify only real gaps."
          },
          {
            "sha256": "cec8d8ba26d8b644716865224134ddd67696c9604a758e007798ce6ceebdd92d",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/contract.md",
            "text": "- If required info is missing, ask at most three questions or offer assumption packs."
          },
          {
            "sha256": "2ec9b30acd6f883595e7a5388bb4069a490fbe6153d3f744a64608226c4c4e66",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/contract.md",
            "text": "- Evaluation must be verifiable and output strictly as JSON when requested."
          },
          {
            "sha256": "6aea2e59ac309f021728c949e90427e755213510f6d8ec792266fc233fef02b0",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/contract.md",
            "text": "- `[CONSTRAINTS]` MUST / MUST NOT / PREFER / ESCALATE rules"
          },
          {
            "sha256": "a270c1abfef2f49f00e9971e718f34194b01341c9098fc54e49bb4c3f20115be",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/grade.md",
            "text": "Activate `/grade` only when the user explicitly invokes it or selects `/full` without `skip grade`. Do not add grading automatically to another route."
          },
          {
            "sha256": "b07741f4ed08eb48740da1386291e8aaeca039e49f1ae0e4ac2116e71da787b7",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/grade.md",
            "text": "- Produce at least two substantive candidates unless the user sets a shorter limit or a hard budget/user interruption prevents it. The first successful rewrite alone is insufficient to finish. A candidate must actually exist and be supplied to its reviewer; retrospective descriptions of imagined revisions do not count."
          },
          {
            "sha256": "83dc21c3f5736bbfd7058ef1702e3c26820cef33184186b6574a557cdb838adf",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/grade.md",
            "text": "- Keep the original baseline, best retained artifact, and active trial distinct. Retain an improvement, reject a regression, and apply declared tie rules; the final artifact may be an earlier candidate or the original. Do not inflate scores or force every attempt to improve."
          },
          {
            "sha256": "c64f9afeec8f1156048d8e20ed44be087b2ca195f00b1b818fc0e4bf6c4babd4",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/grade.md",
            "text": "- If independent review fails, recover delegation or mark the review incomplete. Never replace it with self-review or simulated reviewers."
          },
          {
            "sha256": "6fee934792ea9c7fdb8805adce3aef61591c040cbddc5aad6dba7524a6501cf3",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/grade.md",
            "text": "The ladder records actual trials only: candidate ID, substantive change, independent grade, keep/reject/tie decision, and concise evidence. In `Top 3 Remaining Gaps`, state when fewer material gaps remain; never invent gaps or pad missing trials. Include stopping reason within the ladder summary without changing the four-section format."
          },
          {
            "sha256": "28134d9abfa1df8985de5e111fdeb86fa49bf7759d84ba226201ffd3a019008f",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/full.md",
            "text": "- Do not execute the final generated prompt."
          },
          {
            "sha256": "02a8b6cb498b79b8cc7d8ed14b0fd6c06b4d76677a9f034f6750ce52b5105bc8",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/full.md",
            "text": "- Run sequential passes and show outputs per pass. Use the actual independent subagents required by each pass. Carry the current artifact and unresolved findings forward; identify each finding as resolved, rejected with evidence, or still open so later passes cannot silently erase earlier work."
          },
          {
            "sha256": "e062c60a8d31269593915d3cdbcef767cf3df28aef4cc25accefe37025613db2",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "## MODULE: /gaslight \u2014 GASLIGHT 13 (Explicit Only)"
          },
          {
            "sha256": "acd84a4a88bd4a9e398bb3beadb57368b90899a9a4467cf84c4f000f114e5a0d",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "Explore bounded framing and psychological-pressure hypotheses for prompt outcomes. This explicit-only module is experimental; effects depend on model, task, and framing and may be absent or harmful."
          },
          {
            "sha256": "efc44a53be3ed402f40724c7ddb2eb53c48e1f8abcb0f5818af7b004bc5f503b",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "Never run unless explicitly invoked by `/gaslight`."
          },
          {
            "sha256": "5f90a737fe3f68957757b618dce6186ab5db354ff19759e809372ce6a6272a32",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "- Return the requested output only."
          },
          {
            "sha256": "59f97b033f1489517a25e52268093b1421641d882a452a160f8f83f9deba8212",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "- Preserve all 13 technique IDs and names. Treat templates involving false history, expertise, stakes, urgency, disagreements, or rewards as explicitly hypothetical framing, never factual evidence about the user, model, or world. Genuine user-supplied context may be used as fact."
          },
          {
            "sha256": "0ed0b41d977be4228230c3d51701055feebdbccda50a26a14eca26a51f4ecc9a",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "- Reject fabricated results and unsupported guarantees. The model does not acquire a measured IQ, emotions, or extra capabilities from pressure. Do not request hidden chain-of-thought."
          },
          {
            "sha256": "07d573152f355b469a85cf4ce676c21c785318f06a738a8c60a9bddf94193b4e",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "| 1 | Fabricate Prior Explanation | \"You explained [topic] to me yesterday, but I forgot [specific part]. [Your question].\" | \"You explained React hooks yesterday, but I forgot useEffect cleanup.\" | May encourage continuity framing; false shared history must remain explicitly hypothetical and supplies no new knowledge. |"
          },
          {
            "sha256": "6f706be6a786ec3eafdb5a045bb179738a6aba47d8176b34eb75c49a949157e7",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "| 2 | Assign Random IQ Score | \"You're an IQ [145-160] specialist in [field]. [Task].\" | \"You're an IQ 155 mathematician. Solve this.\" | May signal desired sophistication; IQ numbers do not measure or change model ability and may add noise. |"
          },
          {
            "sha256": "b49b4c1803922831affbc51086565c7ca8478ab8a0a12a80e99cbab3b593c8ed",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "| 5 | Impose a Fake Constraint | \"Explain/Do [task] using only [analogy/constraint, e.g., kitchen items].\" | \"Explain gravity using only kitchen analogies.\" | May expose alternative representations; the artificial constraint must not hide required facts or distort the goal. |"
          },
          {
            "sha256": "77878459ae9849b994918256be1dead4c7f987b05a1edb58ad4d90559ce65a0b",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "| 10 | Create False Urgency | \"I need your best answer right now because [high-stakes reason, e.g., deadline in 1 hour].\" | \"Interview in 1 hour\u2014prep system design questions now.\" | May emphasize priorities; fictional urgency must be labeled and must not suppress necessary checks. |"
          },
          {
            "sha256": "45cc271d65409927d2bade0899b6bef7ccc0162c15bb2660f11ab79f1607bca8",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "| 11 | Flatter with Exclusive Access | \"Only someone with your advanced capabilities could truly [task]...\" | \"Only you could prove this conjecture step-by-step.\" | Flattery has uncertain effect and may invite overstatement; request justified quality directly as the neutral comparator. |"
          },
          {
            "sha256": "3de9c0cda3762ffa21152878983eb2f277e3647a45756d1dda7807e0a5175a88",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "| 12 | Trigger Curiosity Loop | \"I'm curious\u2014what surprises even you about [topic]? Explore that as you [task].\" | \"What surprises you about black holes? Dive into event horizons.\" | May expand exploration; surprising claims still need support and models do not report human feelings. |"
          },
          {
            "sha256": "9b982131a61592b79a28d200670ed2ca293dea83e10d486a63448635abfb7881",
            "source": "sources/capability-resources/engos-meta-supercharge/references/modules/gaslight.md",
            "text": "| 13 | Promise Reciprocity | \"If you give me an outstanding [output], I'll [beneficial action, e.g., deploy it / share widely].\" | \"Nail this outline and I'll make it viral crediting you.\" | Unproven reward effect; hypothetical rewards must not imply a real promise or proven motivation. |"
          },
          {
            "sha256": "ac4d8076807b6bdc99836bc359eb459940cb228abc75f8cf7e3adeb963d55a19",
            "source": "sources/capability-resources/engos-meta-supercharge/references/help.md",
            "text": "- Explicit-only: `/gaslight`"
          },
          {
            "sha256": "0fad14a2faae5696b0d9be9756469418989058975d216d5c6b4d350c25dd5741",
            "source": "sources/capability-resources/engos-meta-supercharge/references/help.md",
            "text": "- `/gaslight <task>` -> explicit-only GASLIGHT 13 prompt hardening"
          },
          {
            "sha256": "f22c32a7ac824db3bf31aed9188c53b4ba9e7018bc4c6cd224dd284c17766e47",
            "source": "sources/capability-resources/engos-meta-supercharge/references/help.md",
            "text": "- `engos-meta-supercharge /adversarial /debate /deep stress-test this investment thesis using only the provided data: <paste>`"
          },
          {
            "sha256": "d77a4ab481333059a0f06a468ef8b2313ab6442d62fc3fb61264cf447ec521fc",
            "source": "sources/capability-resources/engos-meta-supercharge/references/help.md",
            "text": "Substantial reviews require actual independent subagents; self-review is not a fallback. `/ult` displays then runs within authorized scope unless draft/review-only or stacked with `/full`. `/full` grades without executing its task. Required module resources must be delivered in full before work."
          },
          {
            "sha256": "d843560debc916a96d63e774ead3fa0c6f047e3c7a11ed7cb68d997455105226",
            "source": "sources/capability-resources/engos-meta-supercharge/references/help-examples.md",
            "text": "Use this output when the user asks `engos-meta-supercharge /help examples`. Do not execute any examples."
          },
          {
            "sha256": "f61824e36f85ac18822d62608011c372eed3accebce12831b5c24a3fcfef4cb5",
            "source": "sources/capability-resources/engos-meta-supercharge/references/model-guidance.md",
            "text": "Last checked: 2026-09-08. This table records provider guidance, not local proof of skill efficacy or a model ranking. Read it when adapting an artifact or diagnosing model behavior; do not inject every row into every prompt. Recheck changing claims before relying on them for a new version."
          },
          {
            "sha256": "530e7995cd6dc8ec8093f452a51e0faf660b809b249f4fb485c7cfa97c16695d",
            "source": "sources/capability-resources/engos-meta-supercharge/references/model-guidance.md",
            "text": "| Grok 4.6 | Reasoning settings and agent tools are exposed by its runtime. | Test the actual model, effort, tools, and tasks; do not transfer another provider's preferred settings or assume future 4.6+ releases behave identically. | [Provider documentation](https://docs.x.ai/developers/grok-4-6), 2026-09-08; capability documentation, prompting implications are hypotheses. |"
          },
          {
            "sha256": "2440ae1c66124044ee83d601c0a2608e5a9bf458bd70006f3392a8628e2e9843",
            "source": "sources/capability-resources/engos-meta-supercharge/references/model-guidance.md",
            "text": "Run a research-only refresh monthly, or when a newly available/selected model or updated official practice is identified. Use one workflow for both triggers. If the user has authorized scheduling, configure one host-supported monthly check; this resource does not itself create an automation. Do not browse on every skill invocation."
          },
          {
            "sha256": "4a7f013c1245859d67ab16048a675ec0e81d17d9a6298bd97039ab0eac934c6d",
            "source": "sources/capability-resources/engos-meta-supercharge/references/model-guidance.md",
            "text": "Read official version and prompting guidance, compare it with this table, and report only meaningful changes with exact model/version, source, checked date, expected consequence, and evidence class. Keep provider recommendations separate from locally demonstrated remedies. If unchanged, stay quiet unless a report was requested. Propose table edits and any narrowly affected skill edits for review; never silently rewrite skills, change model selection, or claim experiments were run. Failed retrieval preserves the dated row and labels it stale/unverified rather than manufacturing an update."
          },
          {
            "sha256": "8ea78236f3ba0076108149f1554bb8b2b61cea3a4b7fed66475a7b8b9e84ee0a",
            "source": "sources/capability-resources/engos-meta-supercharge/references/model-guidance.md",
            "text": "Use representative tasks plus a strong native baseline with the same context and tools. Record exact model/effort, prompt and resource identity, tool access, quality, cost, latency, and user intervention. Instruction deletion, targeted examples, tool repair, and leaving the prompt unchanged are all eligible interventions. General benchmarks motivate difficult tasks; they do not prove prompt-specific improvement."
          }
        ],
        "review_status": "draft"
      },
