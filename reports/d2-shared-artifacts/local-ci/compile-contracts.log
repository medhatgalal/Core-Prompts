            "source": "ssot/engos-triage-my-inbox-chat-pulse.md",
            "source_line": 769,
            "sha256": "a304774228ea73f58f75f41f7f40cfe2c91967b54f230888821af7d074dedcbf",
            "text": "**In-session filtering with `only`:**",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-triage-my-inbox-chat-pulse:L766:bcc7db97383b",
