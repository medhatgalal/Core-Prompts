ote\": {\"$ref\": \"#/definitions/text\"},\"explanation\": {\"$ref\": \"#/definitions/text\"},\"route\": {\"enum\": [\"research\",\"shaping\",\"respondent\"]},\"source\": {\"$ref\": \"#/definitions/sourceQuote\"}}}}}},\"host_record\": {\"type\": \"object\",\"additionalProperties\": false,\"required\": [\"path\",\"sha256\"],\"properties\": {\"path\": {\"$ref\": \"#/definitions/path\"},\"sha256\": {\"$ref\": \"#/definitions/hash\"}}}}},"
          },
