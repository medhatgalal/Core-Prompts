            "text": "\"reviewPlan\": {\"type\": \"object\",\"additionalProperties\": false,\"required\": [\"schema_version\",\"proof\",\"proof_source\",\"seams\"],\"properties\": {\"schema_version\": {\"type\": \"integer\",\"const\": 1},\"proof\": {\"$ref\": \"#/definitions/text\"},\"proof_source\": {\"$ref\": \"#/definitions/sourceQuote\"},\"seams\": {\"type\": \"array\",\"minItems\": 1,\"items\": {\"type\": \"object\",\"additionalProperties\": false,\"required\": [\"id\",\"applicability\",\"reason\",\"receiver\",\"field\",\"field_type\",\"expression\",\"input\",\"message\",\"proof\",\"read\"],\"properties\": {\"id\": {\"$ref\": \"#/definitions/id\"},\"applicability\": {\"enum\": [\"existing\",\"new\",\"nontechnical\"]},\"reason\": {\"$ref\": \"#/definitions/text\"},\"receiver\": {\"$ref\": \"#/definitions/text\"},\"field\": {\"$ref\": \"#/definitions/text\"},\"field_type\": {\"$ref\": \"#/definitions/text\"},\"expression\": {\"$ref\": \"#/definitions/text\"},\"input\": {\"$ref\": \"#/definitions/text\"},\"message\": {\"$ref\": \"#/definitions/text\"},\"proof\": {\"$ref\": \"#/definitions/text\"},\"read\": {\"$ref\": \"#/definitions/sourceQuote\"}}}}}},"
