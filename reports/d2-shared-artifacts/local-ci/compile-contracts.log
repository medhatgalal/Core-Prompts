            "sha256": "3ebb7063465ac352008213ff56be4c37dc61268b06eed193c0e1749726d6b47e",
            "text": "Create a coherent, visually rigorous deck that communicates one clear narrative, works interactively as a self-contained 16:9 HTML presentation, and can be exported predictably to exact-size PNG images and a visually faithful image-only PPTX when requested.",
            "kind": "guarded_invariant",
