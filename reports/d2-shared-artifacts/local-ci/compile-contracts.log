        "protected_invariants": [
          {
            "id": "engos-memory-context-continuity:L4:1c3f41efe054",
            "heading": "Purpose",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 11,
            "sha256": "1c3f41efe054d3acfa733797b0c0b16c7535f136bdf90af83a6030152eeb9936",
            "text": "Use this capability when a multi-file or multi-source investigation must preserve its goal, evidence, findings, and progress across long sessions, compaction, session replacement, branch changes, or worktree removal.",
            "kind": "guarded_invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L6:ac3306740e69",
            "heading": "Purpose",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 13,
            "sha256": "ac3306740e697acc9ce358aa33bc13095ec1e9069b5c129a7f47769079ba9719",
            "text": "Large context windows and conversation compaction reduce recovery frequency. They do not replace durable state on disk.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L8:050433e604b4",
            "heading": "Purpose",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 15,
            "sha256": "050433e604b4bf4e3768fef92dd28edd475e8a2ef30a1d0b5782f409ce10c7e6",
            "text": "Do not use this capability when the main job is to make a final decision, harden a prompt or plan, import a capability, design a system, or prove one variant performs better than another.",
            "kind": "guarded_invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L18:1e6a8ec73c63",
            "heading": "Workflow",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 25,
            "sha256": "1e6a8ec73c63aa2c52da42757d3373ef25b52176dbc7278efd853db031e32b84",
            "text": "5. Mark the task complete only after every TODO is checked and the insights file contains the final summary.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L21:63685b20ecb0",
            "heading": "Storage Contract",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 28,
            "sha256": "63685b20ecb0fe827f07b1da897d3bef0bd17eb0ada7ba8f8af2cd2ea8770dad",
            "text": "Store each task outside the repository in one collision-resistant project/task directory. Do not construct canonical paths by hand:",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L30:0d1a21fe6f29",
            "heading": "Storage Contract",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 37,
            "sha256": "0d1a21fe6f29361e831827f8dc00a3ff9ea298d35d21af67c3a1ab04004f9922",
            "text": "- The helper normalizes the absolute Git common directory and derives `<sanitized-repository-slug>--<first-12-sha256>` from that identity. All linked worktrees of one local repository resolve the same project ID; unrelated repositories with the same basename do not.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L31:d868260383e5",
            "heading": "Storage Contract",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 38,
            "sha256": "d868260383e5daa2d35e2eb3847b2e923e7a9027ce34e22d11e5db6f5a1839fb",
            "text": "- `TASK_ID` must be 1-80 lowercase letters, digits, hyphens, or underscores, and must start and end with an alphanumeric character. Reject empty values, separators, traversal, control characters, and every value outside that format before path construction.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L32:9d3e841b57c9",
            "heading": "Storage Contract",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 39,
            "sha256": "9d3e841b57c982e08442470451e88a7c035eda60d9b8d1f1eadbfb3d40971d7e",
            "text": "- `ANALYZE_CONTEXT_STATE_HOME` may override `~/.analyze-context`, but it must be a dedicated directory outside every worktree. The helper rejects task paths that escape the resolved state root.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L34:4690068debcb",
            "heading": "Storage Contract",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 41,
            "sha256": "4690068debcbed610e352c993039af9b79da442e2da567d66ce40388b17ef108",
            "text": "- Branch and worktree names belong in the context file as metadata. They do not determine the task directory.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L35:fb9eb81e13d4",
            "heading": "Storage Contract",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 42,
            "sha256": "fb9eb81e13d469ca57cfe07c039026bbb765cf6b3ad1c430bee5c0fdd90e6fdd",
            "text": "- The store is machine-local. Use a reviewed export or `engos-memory-threader` for cross-machine handoff; never commit scratch state automatically.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L39:4b0f7babb257",
            "heading": "Tool Boundaries",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 46,
            "sha256": "4b0f7babb257872e4d853cf378c907d84b7debe26ba0fea78494df0df2baa4f5",
            "text": "- forbidden: pretending analysis is implementation, silently changing unrelated repo state, treating provider-native memory as canonical, or replacing canonical source documents with temporary notes",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L44:e9ce2fdada70",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 51,
            "sha256": "e9ce2fdada701792eafcbc4dcda8ecbfbf3049550c9b2c7cdefdb2fed676366e",
            "text": "- Do not fork versioned analysis files for the same task.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L45:6be6efa79bda",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 52,
            "sha256": "6be6efa79bda361054a1a1ff0ae0e578999407e319be37afd2ff5e650b0dfcf6",
            "text": "- Never write canonical analysis state inside a branch, linked worktree, or main checkout.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L46:9919e22e6020",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 53,
            "sha256": "9919e22e6020d51ae7a614e5bbc562bdc71caa01c4f821390882dcd04c572128",
            "text": "- Do not treat session end, compaction, branch removal, or worktree removal as completion or cleanup authority.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L47:d983c4341add",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 54,
            "sha256": "d983c4341adda708e0751816db5069b8ede3a568218da1ae5c7cbaa122090737",
            "text": "- Use a distinct task ID for each concurrent task. Read only the exact task selected for the current work.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L48:a51bde1a9d5b",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 55,
            "sha256": "a51bde1a9d5b5f113204c5da8dc4f8cbde6b2e6e56fd34f7f4a5db02765604a6",
            "text": "- One task has one writer at a time. Another session may read or resume only after the current writer stops or explicitly hands off ownership.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L49:6f3bd53b0f28",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 56,
            "sha256": "6f3bd53b0f28d5a5b01416aba0bdeece03f087ca7f7f98e6f018f16b1159381b",
            "text": "- Treat legacy `.analyze-context-memory/` directories as read-only migration sources. They must remain gitignored and untracked until migrated.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L50:2bfeab027cf8",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 57,
            "sha256": "2bfeab027cf8c50fecca59a18bf827d7af10762861a3bfeac98e63f83e954532",
            "text": "- Do not keep important findings only in chat history.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L52:ffc51a116d08",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 59,
            "sha256": "ffc51a116d08d4d0445ff1a3b9fa1f41ca42f9b775611489973fb4d21da99a4e",
            "text": "- Mark a task complete only when every TODO checkbox is checked and `insights` contains the final summary.",
            "kind": "guarded_invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L53:55acc6f8dba9",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 60,
            "sha256": "55acc6f8dba906f771965d3cb036bec211962ba4ccc48527b119247a8b9232e3",
            "text": "- Completed files may remain on disk. Cleanup is optional, later, and user-approved; hooks must never delete them.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L54:608e248bbee5",
            "heading": "Rules",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 61,
            "sha256": "608e248bbee5d8bcda3de63b15df4af1793476fc62bb49f74e35fa45f5b53ea8",
            "text": "- Do not store secrets, credentials, or unrestricted sensitive source content in analysis state.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L67:1da0cc04596e",
            "heading": "Trigger and Checkpoint Rule",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 74,
            "sha256": "1da0cc04596ed0715c2207aeeb810bf21675b787413b89ef9ff5c02c39d08440",
            "text": "Do not invoke this skill for a quick one-file answer, ordinary code review, or short-lived lookup.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L73:c54d0465cef7",
            "heading": "Hook Reminders",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 80,
            "sha256": "c54d0465cef74ce130c73fcc9fa81e7ff7e60dfcbd2638474f632fceca4b3401",
            "text": "- On `PreCompact` or `PreCompress`, remind the model to update context, todo, and insights before compaction. If the host event is advisory, do not treat it as the only checkpoint guarantee.",
            "kind": "guarded_invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L74:3476fd9b6406",
            "heading": "Hook Reminders",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 81,
            "sha256": "3476fd9b64062246da7ecc1dee0f08888dcfe9309e97039f05250f960ad59888",
            "text": "- If a host lacks either event, continue with the skill rule; do not emulate it with noisy per-tool hooks.",
            "kind": "guarded_invariant",
            "mapped_to": []
          },
          {
            "id": "engos-memory-context-continuity:L75:f768408943ac",
            "heading": "Hook Reminders",
            "source": "ssot/engos-memory-context-continuity.md",
            "source_line": 82,
            "sha256": "f768408943ac8c2a270858325b229cb03de76fbb8318f95cccb3ced836ec5a7a",
            "text": "- Hooks may read paths, validate freshness, or add a reminder. They must not invent findings, mark completion, move files, delete state, or bypass one-writer ownership.",
            "kind": "invariant",
            "mapped_to": []
          },
          {
