            "static": 0,
            "native": 0,
            "routing-canary": 300000,
            "canary": 1250000,
            "promotion": 5000000,
            "cross-host": 12000000,
            "sweep": 30000000
          }
        },
        "runtime_envelope": {
          "required_cells": [],
          "cross_host_required_for_pilot": false,
          "status": "unresolved"
        },
        "promotion_rule": "Change-class-specific proof plus all hard gates; no aggregate compensation.",
        "rollback_trigger": "Any protected regression or stale bound evidence.",
        "source_clause_hashes": [
          {
            "sha256": "142f7fbe12ac440b0a71a831f2c5082147b44b07e32118ef6e937fd5099975ca",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "Permit only supported, current stage transitions. A useful hold identifies the"
          },
          {
            "sha256": "77357dbdaba34183181a2940a8cdce735aae457d5f4694b620c0fe81799c73b6",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "## Required Inputs"
          },
          {
            "sha256": "242267879ae29c6fc952d22a9d7be457c8ab462e48ae69cd1c4517feb32e932e",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "2. Inspect actual prose, citations and required artifacts. Explain each failed"
          },
          {
            "sha256": "7d2f37c3db70241cd5e99ed8fa011ebc716cf35f2e57f11f60c481be5e2638cb",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "transition; continue independent work only within the current phase."
          },
          {
            "sha256": "45272448ea84fb509fa102feb9ae79a752240d426f32924b96d1176e6b0ecb78",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "work order, policy and stable reviewer identity. Include all required artifacts,"
          },
          {
            "sha256": "cc05ed2a8f08cb50fa271719fae7473f37597d86026e214d5ab45ec08063f25b",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "forbidden lists against the pitch; no silent drop, addition or scope cut."
          },
          {
            "sha256": "6b500030b83b0e214e1eed2ceeae58549956ed442b9ea34dfbb34dcfb36c832e",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "Check that API and skeleton choices occurred only inside shaping."
          },
          {
            "sha256": "735d4021ee5fd5727f21e611ab4c66eababb2bfb07c90540a5468432c4e2c7a9",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "Word, JSON, Markdown, or all of them. All means all five; verify only chosen"
          },
          {
            "sha256": "cf1284bf3066487cc5bab4d98ca880494d9dfaa52f2ae51253b58daeae39b6de",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "fences, captions and full contract/security tables. Required content precedes"
          },
          {
            "sha256": "1af69983c709c1f16b46f28d7487adb94479bddcf6c09297952bb3d520723161",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "saved target's revision, content, tables and diagrams. Word is handover-only"
          },
          {
            "sha256": "8f60881a768a0ad5c446793c848c3b60e6192cedfc56d600a2422542be04b33a",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "A successful upload, empty target list or source-only image check is insufficient."
          },
          {
            "sha256": "d4bf498cbc496a213fbc8f7f66c0f6858f36b0b7998116cf84cb1c0d066f9dea",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "the reviewing worker never writes accepted state or approves its own work."
          },
          {
            "sha256": "3d4b9f171064970a2e9947e6e3f0fb13501d9ced9a9ac9ebe2cde123882829ec",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "## Required Output"
          },
          {
            "sha256": "782c78f2e0b2778c2f205bd1d39a1437bb79451687c33b19962f675b12d16516",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "top fixes and three hardest questions. Never substitute `complete` for a verdict."
          },
          {
            "sha256": "6bffcc5574e26cb27886d3e6e38cf10cb1319d164d3a9a0fcadb0f5e1c07aaf0",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "score anchors at shaping depth; do not demand a built feature solely for points."
          },
          {
            "sha256": "ee284d140306499a6ebdadb40f3ee7a82800f87f22ef1cba5e785be40f272718",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "adding a deferred line or building a forbidden line. \u201cProceed and loop\u201d continues"
          },
          {
            "sha256": "152661f169b949fcf3822daea52bb718ed6ba9dab4d35ba5f25e3fb9f71ff1b9",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "person's handover prose. Source inspection establishes instruction coverage only;"
          },
          {
            "sha256": "de0f8aa8997e9b2263036ecc6d5ca37b119513886cb863f87b314082e1069a3d",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "behavior may be absent. New/nontechnical seams need reasoned applicability, never"
          },
          {
            "sha256": "e13bece0c6ceafe3af743f0b0e5cff89540fe6224b2f3a5158d8340709de7f3f",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "not required for that evidence. Dependent answers need the named respondent's"
          },
          {
            "sha256": "5025330ae387b30c46f09a93b7c934a9d2742e62f87f741fc48716d51223e2f1",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "authority and observed provenance, never fixer substitution."
          },
          {
            "sha256": "f35f7231128a0ee1670e14b75fae75e83dafac1b3422e5cdfcf7af3ae043428f",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "Report concurrent findings and prerequisites. Routes do not execute transitions;"
          },
          {
            "sha256": "7f39533778184137138cb6b78a4df7ba0d277d5ce6d6e5fc26fc96eda0038672",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "Offer a fixer independent of author/reviewer only after failure; start only with"
          },
          {
            "sha256": "8d9e596667882e483c9744c469f8783994791542251aa94fc7755a59f48151c4",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "worker provenance and permission boundaries must be observed separately. It is not"
          },
          {
            "sha256": "fcc05be337553ab7b0c9d6b386c009c8034b303845b1a0c3ffbee5b175ea919f",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "pitch retains content-ready status when only its requested publication is blocked."
          },
          {
            "sha256": "b192df10d3d66a39ddb758a61751cbe4d42f245f9bb2950145fbdb8dcd7e5018",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "are applicable. Simulation, snapshot time and unknown activity must remain visible."
          },
          {
            "sha256": "9c893fba532430ec2a337f4a8dad5a0817e7d81892969e9af3567d5b2c219084",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "The projection never accepts a stage, overrides drift, appoints owners, publishes"
          },
          {
            "sha256": "ea9386a5d8cc9b6a05e7b3f0fcd88fb86557b479b53ad03bad7617f7e603e6db",
            "source": "ssot/engos-quality-shaping-gate.md",
            "text": "assessment. Do not invent code findings or force architecture into framing."
          },
          {
            "sha256": "8a9108be7651b8ac6d01fd880bd7615123f1b7a437d096e1d0ab4e8d51456fd8",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "| Gate | Current inputs and required observation | Hold conditions |"
          },
          {
            "sha256": "ebbd90e9f5716998e9e3e124de069799e4e04353be0a3915f3267059df2d74a7",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "| G4 Bet-ready | G3 current; nonempty requested targets; full source-to-saved-target text/table/diagram parity and revision; representation-appropriate verification; faithful betting preparation | Upload-only proof, omitted rows/images, stale target, unresolved external edit or publication operation |"
          },
          {
            "sha256": "1a91d9d67479e85f0119d3ca64b581f21042bc8b4ad02f5f90c4388abd297bf7",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "The conductor records every failed review in the existing journal. If the only"
          },
          {
            "sha256": "c80d4613fe997aa8be3897b6106346abd55e107716cdc9c75d020e551b42ae41",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "An actual G3 pass is required before team acceptance and the betting table; it"
          },
          {
            "sha256": "25f3a870aa3b003579f4a64feae3e67166c257f49896d6b9744aff1d43ed1704",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "does not start downstream documents. A separate build session starts at spec only"
          },
          {
            "sha256": "a18a2e9db0337563243893fb6e80e38926b7addf38ad7a5db926ab07de555edf",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "Pass only on the actual current subject hashes and policy version. A reviewer who"
          },
          {
            "sha256": "63be0a818ddbde0e210db5565af6040b821c4e0c95c38de3454dabb172873b7f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "human assessment of private evidence must bind source revision, scope, result and"
          },
          {
            "sha256": "02c669626237dbd709efb0dcd5e4b7877cfabd6a15fdab53bfd9a54516fbb895",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "limitations; never relabel it AI-verified."
          },
          {
            "sha256": "04db997761ef3e5402710873e44e3d8ca3f36e8f665bde88ae9c118c4ca96fcb",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "policy-required output, questions.json, decisions.json, diagram sources/renders"
          },
          {
            "sha256": "738e3729e8ebf49a44a0115e875c3e9338d2fdb7c2a110c28e80f74c85f8fdb8",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "semantic and visual observations bind the immutable packet hash. Never require"
          },
          {
            "sha256": "a63026df7ece5c195768de0bfdcf036837d12bffac7709f8210212ffd2826fec",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "Reviewers open required files and cited spans in order. Require host-observed"
          },
          {
            "sha256": "983f505bf3269887290f424a0284e9a4f0fe658a8710efd61565cdac04bfea2e",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "review with its precise gap. Never manufacture an observation. Each component,"
          },
          {
            "sha256": "8b6ebd5bbe761254d6e21d9c1dc672b7db4e8e1fc8ec32f7fd558a6e0e05e80d",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "images or an unrendered SVG do not meet visual review. Reuse the existing renderer."
          },
          {
            "sha256": "03887702d1407216975ed96ef5aa7757f0b6a9d35ad60d94009dfecbbcf2f044",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "function must already read that field: a comment, unrelated read or similarly"
          },
          {
            "sha256": "7fd932b1e3a883402b682578bdbf20e958c6b88384fa31e8fc592cc705776abf",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "a proposed predicate over a genuinely existing read is legal. Do not replace this"
          },
          {
            "sha256": "956f49e55876439313441ef17543e19f3101829b6b1897fd14b2c2f437ec2fb3",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "An unanswered in-scope question can remain non-blocking only with its ID/text,"
          },
          {
            "sha256": "427c1eb06f1fa736679ac9d94e591bc35fa7c49d225a3505a00a020d24fee2e6",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "they never dispatch or transition automatically. Do not repurpose next_state: it"
          },
          {
            "sha256": "3b9cf6077ef03401574722eb3d85bfd97749f7c60b7ace7244ad8bf2a0b20785",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "must still equal the assessed gate. Legacy schema-1 string findings remain readable"
          },
          {
            "sha256": "182224149b8d528783f452f5d2b44b4d9d177ccabe06d1995aace753658f3207",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "only after explicit user acceptance of that particular repair. Bind stable host"
          },
          {
            "sha256": "6e9130c4cdd156a8263787addc522ea30e37eddf88ea07087406253d5ade884a",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "otherwise authors a revision cannot grade it; role/display-name changes do not"
          },
          {
            "sha256": "cb4547686bf497ced6bfca4d10552e7e2ed68626c9ef9d8183ba09a7c22333e9",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "boundaries and relevant trust and contract constraints. Compare only credible"
          },
          {
            "sha256": "3cfba070ca0b476f7995feb1e5955886d777a9de5aad6424c58da989206184ff",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "required. Identify migration, owner, rollback and retirement implications only"
          },
          {
            "sha256": "0864524aed6dbd5adde3564b61b7003c737666d9679e08dfe2c7345bbb63964e",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "Contract completeness and security ownership remain required in every applicable"
          },
          {
            "sha256": "92144e81907dee978bf8086cb930f44d09aa200e301fed3228471ed69f2d71fb",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "Do not force reuse, a positive search result, or DRY-driven consolidation. A"
          },
          {
            "sha256": "142ad5c2a08c8c6bffb84b0222cef12ac7a1f07faef697523776a3f57e667edb",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "evidence and rationale; do not omit the predicates or invent technical work."
          },
          {
            "sha256": "254d67a17700ae0bc76f0847110405d9823f122ad2e893db5cbff09faa020b2f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "pitch, uncertainty and decision artifacts; do not create a duplicate tracker."
          },
          {
            "sha256": "e4f7203723d676ffa386d1150494f72aaafdf052ced170b49f89e7d04c4cc64c",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "- sequence.mmd must remain a real sequenceDiagram. For the documented limited"
          },
          {
            "sha256": "7fb36ca2a2960d2521622408b7b36c02c84ae72e3ff6411b4397178c436fb711",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "are acceptable only with role-colored sequence bands and an explicit legend;"
          },
          {
            "sha256": "aa7e5a426fdf68ebfe29ba7e527ae1f5b7821afc88cdd9dfad2346f2fa63b0c4",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "actual rendered pixels, not only a parsing report."
          },
          {
            "sha256": "f38a8db04ad1844aa42ffe435b7db1fb86ac2cf0be33e974f7578174a03b062e",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "meaning, producer, consumer, state, evidence and owner remain required. An unknown"
          },
          {
            "sha256": "e92f170416256fb71de1274b53acc9a82c8bb9b4e126629af3e52fff538045e2",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "interface remains a research gap. Use only evidenced methods, paths and schemas."
          },
          {
            "sha256": "a9e0df0c00a0477d854a7b212b6ac238e08806c3983a64633859aae1daa577f9",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "consistency and persistence constraints when relevant; do not invent internals."
          },
          {
            "sha256": "9b73f5439677836866afd65dce9e4a2594fade4516f472ff3627a1a5201e2840",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "Check agreement with the diagram interactions, not only populated cells."
          },
          {
            "sha256": "4048f6768e6ff3161a9ef6aa528511b7732e79046d92936149c41f4c5c91c542",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "never rewrite them or label old passes as new-policy assessments."
          },
          {
            "sha256": "e961b75927a0c7d524d3f92290308e72044ba0c99d1fe08a96a72fb14ce9d2b1",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "ReviewReceipt schema, never substitute a free-form `complete` label."
          },
          {
            "sha256": "5489dd44de203c7bcd70f6627da63e23a2cf145e36cc6fd604c6199af7c56ada",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "Only the controller accepts immutable content/question/decision snapshots. Workers"
          },
          {
            "sha256": "44667938a9538fc972f0a9fa6b5e0357729a62cb77ce83f6c9f7926d55bd023b",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "diagram inspection even when JSON is the only requested delivery format. Verify the targets actually required by the request; do not impose the original"
          },
          {
            "sha256": "c2b7c16937b36a4035153a9d26c5d1fb54c807a1a5a46272fb9de9c7add5f538",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "pilot's platforms on every team. Where HTML AND Google Doc were required, including"
          },
          {
            "sha256": "92779efdc8464b9ecefbc2eaef28ed59c650aa6d7c2555ed4375f30e80422172",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "that pilot, both targets remain required alongside any JSON export. A frame-only request ends at G1;"
          },
          {
            "sha256": "64ba327ab9b484a9cb63875dacc0fec77241ad06e8b5400a262c71e0132c1826",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "a shaped-draft request at G3. Never invent prior gate history when auditing an"
          },
          {
            "sha256": "e98165b9643c789ebffb55b46102cc390c8c4a2699f655e929ccaf0fddf81644",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "walking skeleton is offered only in shaping and omitted when there is no code to"
          },
          {
            "sha256": "cf3679611b46cfcf9a07a5df5ff21f71be447edfb7833bb82a50195eb999c9b0",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "one must be corrected or split, never silently dropped or falsely proved."
          },
          {
            "sha256": "cd5db6ebb5210c469f9353077e4ef338ff2a92df965e16e3976f5b5190742380",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "- Do not build: every forbidden line."
          },
          {
            "sha256": "f907e7e5c953f23b904b0f0eccaa5bf0c7e60b3eb16182cca33ea86a0e1671ba",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "- Next: a separate build session starts at spec only for the build-these list."
          },
          {
            "sha256": "818b5ab2a59d1543d0e30ef493320e8dced2de51f412aba3c4844f1a2572958e",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "Hold missing proof, omitted accepted/deferred/forbidden lines, conflicting lists,"
          },
          {
            "sha256": "6bcf7fcd07cdc0634737bb12be4da93d1d32fe545c5e6d6d3a6c77a1ff33bb26",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "and may not pick up deferred or forbidden work. \u201cProceed and loop\u201d continues the"
          },
          {
            "sha256": "5e17a9159fb46c7681bfd56f69504b66d6ec5c4693a1f436a8b3ef34d3cb3590",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "Produce only the actual selection. Reuse component.mmd, sequence.mmd, data-flow.mmd,"
          },
          {
            "sha256": "444fed3c81ccf792a098cb0304110a10ac72da655fdefd30e938f212bf6cd5a2",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "existing embed/render paths; use the host Word skill only for a handover Word"
          },
          {
            "sha256": "c858ea7a7d659364fd5af2cec6356b1d82df4622bbf5138e4abdcc4ffc66e440",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "copy, never a second diagram renderer. The person's document contains short"
          },
          {
            "sha256": "453a9eeb401cd65a31449c03c9ee68b820130b29762e26d18192df1814aa8a2b",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "preserve three Mermaid fences, captions and full contract/security tables. Required"
          },
          {
            "sha256": "50a6c8d44a8661754f844499af87fbc4a8026d8f57f71badf31618c8659164aa",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "and the bet. Never create a second authored prose document. Verify each saved selected target;"
          },
          {
            "sha256": "819ca7e9f42f099b64becd6d03aa7374e586907c7135062770f900c1e25d9ba6",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "the full data-flow/security bundle and any sizing required by the team's existing"
          },
          {
            "sha256": "ec70a3c30244e91d85d19e799599e82c481095a76e5c3b543b15de907caa5324",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/gates.md",
            "text": "package returns through the existing affected-stage review rules. Do not rebind a"
          },
          {
            "sha256": "6353e5a5e9ea1dbc74423cd205aff2ebed07d4eff0134ca56cd822c7db5ac6c6",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "caps Feasibility at 2. Missing required content scores 1. No dimension below 3"
          },
          {
            "sha256": "8876a2dc52e3810c80d741aaeb50075338303352b75a89718e5f1c427d32f743",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "passes; all hard gates must pass regardless of averages."
          },
          {
            "sha256": "1d966adee063d7e5088206a1c83e6c1460396860f4f3f6eb37ea136507c9fc8c",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "to an old pattern is neither required for a 5 nor sufficient by itself. Do not"
          },
          {
            "sha256": "586615794f877e28165b273285f7a5befa36f0133a8fa58bc8954c1d95850d8d",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "credible alternatives only, and assess migration, owner, rollback and retirement"
          },
          {
            "sha256": "54cdf619a8fa82a5b4d36df2bd89037ba5eb257bdc7e4fe38574bbc6febcfc14",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "implications when applicable. Do not reward forced reuse or DRY consolidation."
          },
          {
            "sha256": "866250db7d91ff2feae899c023c9b063224a23976ff75ff593b0b4cc68200bd5",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "and its supporting evidence; do not invent a technical requirement to score it."
          },
          {
            "sha256": "a012db1526c2bbffee4e2ce3fe4092e72373d7e95da4c6a14a32bc8734380366",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "All twelve dimensions and existing quality thresholds remain required."
          },
          {
            "sha256": "19b0ef7d37d0605bdfc24f9183fa343850d924f90350304cff2bbad954232c44",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "equal-weight mean of all twelve scores (category means are reporting only, as in"
          },
          {
            "sha256": "9582e230aa99fac92a17a8d663944a51dba5461ae606afabbc27cc047788c3b3",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "average under 4 is the only miss and every score is at least 3, the conductor must"
          },
          {
            "sha256": "372f5cf2c0d98c29ccdff349effaf9af2517e8083cf0af752c523d8956a27500",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "take their appropriate repair route. Ask focused questions only for material gaps."
          },
          {
            "sha256": "3166048ccc8a87ebdfa04ba267b82f056d55f9300d5ea7a0af1972d88f25b99a",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "Score only a selected coherent set. A no-selection output is a hold naming the"
          },
          {
            "sha256": "4f3b790076ee3c281539c9626e80e7c2161a3a5851a71b2d64ec41e519ef2208",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "its researched seams and feasibility; do not require the proposed write to already"
          },
          {
            "sha256": "02411724249d3b58a9013e246a154536a78cff8c293bf8b07725a337f12e666f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "exist. Proof slices must observe the accepted frame's requested completion or stop"
          },
          {
            "sha256": "3857e004778607391c8ce074ff2fd4a254cf19ac06676f9841d5c137c3964356",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "a missing critical compatibility result must still hold at G2/G3; a polished pitch"
          },
          {
            "sha256": "62e0fc3c639a76d16c461285edde56d932c05d4b19679e2945f37c53310870a9",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/rubrics.md",
            "text": "must apply these distinctions and compare against actual team exemplars. A"
          },
          {
            "sha256": "8ba2647b7b1390c0f18b59dc398b9937c462311f04761c8bb093ecf61dd843cb",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "Apply this protocol only to future policies with `review_evidence: true` and a"
          },
          {
            "sha256": "5a59e164df385dcdc5e426c8bdbe414dc0a05447dedc980b88007202e15030c6",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "new policy ID. Missing/false preserves schema-1 history; never migrate implicitly."
          },
          {
            "sha256": "7c033628cf0976d427fbe2f2db80e8eb8a13d46111cfb0c9eb3e44a72738c976",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "`next_state` remains the assessed gate. Returns recommend repair, never transition."
          },
          {
            "sha256": "58adae344419380b7783defd66ace12f2436a2315d129336160e4b1a61455013",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "holds review. Test observations must be labelled fake. The host must protect its"
          },
          {
            "sha256": "6c8d1002a1956f4bd76f7ed900d3ae5e195fe561f2990dbc475cd3be5b34f81c",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "Semantic judgments are independent assertions; never infer truth by regex or"
          },
          {
            "sha256": "5c3391ec777209cbce3130a4ad856990db2adf7b1609011cf192f46a9b897d55",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "connectors, visible content and source agreement; helper checks do not replace this."
          },
          {
            "sha256": "2a6e46426b507f1aa54ddb87c1126ea9cd69bf85f6f6fd0c40cd292689a72e2c",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "reviewer IDs, all contributors and repair records. A fixer must differ from author"
          },
          {
            "sha256": "2f784720ce0c6cee8334099d678e97b0f06cd51129808ef5762f48998e185d23",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "Unavailable identity holds. Supplied strings never authenticate identities."
          },
          {
            "sha256": "bb87569c69901b799d27958edf4350585b8570d57b15232c63784221cb4472dd",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "false consistency with no structured contradictions holds. Routes must be owned by"
          },
          {
            "sha256": "01f8304f5e669661ccdbe22da12b507bdea0649aac9648dd971e699d1114793f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "structured failures and prerequisites must be acyclic."
          },
          {
            "sha256": "76494bc87d2e81ae0a351a97f57b14c2eb8d45bf5930dd1f803437e19ffe3a11",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/review-evidence.md",
            "text": "Disjoint evidence proves separate byte spans only; independent review must still"
          },
          {
            "sha256": "5de577c15d0e80dfb17c77913b3e6ce8298d4f95935417a5ca1ea1a2a5dc623e",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "The host must restrict accepted state, policy, reviewer assignment and this CLI"
          },
          {
            "sha256": "c1ed5f64fc47d0e9b224f8721b095a192f31be7994256ed6446b4e910cef6d30",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "to the controller. Workers receive their candidate directory only. The runtime"
          },
          {
            "sha256": "348771966236115315061db34aad13627fb14e045d251e899bd09a2d663f261b",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "The host must quiesce candidate/source writers during seal and acceptance. The"
          },
          {
            "sha256": "efa607fdd32ee9a66aa4cf2198b903b27206fc57b0984dd12ec0fd7ed719dbe7",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "files. Hash rechecks do not provide an OS snapshot of a changing source tree."
          },
          {
            "sha256": "b4000988cc0e3b642b9e51432b596a65f5000233d0b1628ffcbd635891f6bb73",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "evidence and context evidence in `prepare`. Assignment/context files must be"
          },
          {
            "sha256": "f323493dc1774ef9f64c3ca7124543ed8bb071418923b194846180c6563a3844",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "is required at every gate, including G3. An author-written label or a test fixture"
          },
          {
            "sha256": "7c7652fb3b58bf1b2d5a61f4bd30fb17ca65d66750ef07da775b054a87a7e333",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "and `pass` strings are never interpreted as proof of truth. Missing/failing/"
          },
          {
            "sha256": "59eaee507c905c903801e0cc54efb3de1621d3108a3c1a0af0d434f81f007178",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "are mechanical regression evidence only. They are not independent review, a"
          },
          {
            "sha256": "2737279cbc73079dbfa7bc898d6314e39e9076746f4f467088d0f2e02a6ff0fa",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "are filesystem paths. `--policy` must be inside the run. Absolute/nested symlink"
          },
          {
            "sha256": "253a9e1d5802049e8984c8bdbd95a140cd0c4dedac2cfefa90f3b8470759b9ed",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "-> `sources/rubrics.md`. No additional policy resource or tracker is required."
          },
          {
            "sha256": "009f9d9f6f3f47b824dccd89f7d1ba24afb2095cdc1e73cdd52b105d35e1da29",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "Frame-only and shaped-draft runs may set delivery_targets to an empty array."
          },
          {
            "sha256": "8894da2a4bd9a6e150e671ef40fa8274ba54c76a26338eb0310e0707e7729096",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "G0\u2013G3 remain available without publication. This never permits empty-target G4"
          },
          {
            "sha256": "b58e4cb2105541c7b83d45a85d976841ee6011cfb0de4a3232ae8cb434aedef6",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "Google Docs because both remain required for this task's complete pilot acceptance."
          },
          {
            "sha256": "32def7740b68f4e8f6b16960b4b2f02b201fed52463de7297e13fb05b8bfd0a7",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "# Dispatch the author only now. Its writes go to candidates/G0-intake-a1/."
          },
          {
            "sha256": "1737ad3fb6cc1aa67a6232d26edb21583fb1a775bebfaacad2d143df4221443c",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "All commands have `--help`. The optional read-only `progress` projection and"
          },
          {
            "sha256": "447534204a6f37c35a8fd3261fc74f13a614de49721520c54918235c98c24bde",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "\"original_constraints\": [\"Preserve the supplied problem; do not choose a solution in the frame.\"],"
          },
          {
            "sha256": "1a212b2df9f15bef59c7c03c2b8ecff8b86e046e86ca575c5e660bdfb07f3baf",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "\"source_access_scope\": \"Only listed sources and explicitly approved source inspection\","
          },
          {
            "sha256": "ff0b73e069cb2d612da33035e92f8a43687e9150894218bda91de2f76aa2e962",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "required outputs/predicates, accepted question/decision snapshots and return schema."
          },
          {
            "sha256": "0870a7ac254a0594b7fb659c482c44d46e944064ab3ba3ff1f8d5c612de2423f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "The directory must not exist before assignment. `seal` checks required outputs"
          },
          {
            "sha256": "8d109d4d33964f01d7368da9b02900565eae2240f46b65b25085f40d845ec131",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "must belong to accepted G2 files/inputs. The controller designates this exact"
          },
          {
            "sha256": "d165c3bea546dc5346aaaaac89102cbf47442e9c1914f33307173eb729a5ad86",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "proof, whose text must equal the quoted proof bytes apart from terminal newlines;"
          },
          {
            "sha256": "aa3cb72252c42773097a1fbf2158fc1b57187f5b89dfbe6f9263e085efb73948",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "Consent and origin are bound separately from the repair role. Do not dispatch a"
          },
          {
            "sha256": "01f6723e8c741494a905aa85e904fef1c1cc1c7c5bf126e085ea8fc294af8605",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "hashing itself. Only AFTER seal does the host open the ordered packet and renders."
          },
          {
            "sha256": "66d32b2758852833fad66c9319e83be7266cf1064919dd7edf6189fdfb15a979",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "`openings` copied from the packet ONLY after actual observed opening, final"
          },
          {
            "sha256": "9b9bb9e3ddb59bdac7073e6a87d61cae2aa908579157fd10c5660b4b13881077",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "must restrict this command/store to the controller. This is consistency evidence,"
          },
          {
            "sha256": "56ce3a6092b0d0147a99e250225281cdbf312e9d2588075c71a99e19d3bb4dfb",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "source/sidecar drift must be reconciled; retained observations remain immutable."
          },
          {
            "sha256": "99bf27418e005d74959b02feb2c9b44f6ac941132dca0679113bfb514296908d",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "The helper checks these bytes and structure; only the independent reviewer judges"
          },
          {
            "sha256": "b050dec040681a9a23b0ff9a90db79629b2c95ef5dc7094de600da9272aabdd7",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "finding with a source-bound repair route; prerequisite IDs must form a DAG."
          },
          {
            "sha256": "81d17b67a73226d1d58deb732e9e4b0b1dd054796c9024ebcc1025e3161b60b9",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "findings. Typed returns do not change `next_state` or trigger repair."
          },
          {
            "sha256": "2f5eebb79caa9fd2271242662a0263cca3ae28f330a678e64a4c3f1a2e06387f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "later stages may add files but must reopen the owning stage to change earlier prose."
          },
          {
            "sha256": "7e8ffcf5391d5e024e9e44db41c635cd8e86b4d5bc211b1b25106c56f429e671",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "| Gate | Required new artifacts | Mandatory semantic IDs mapped to gates.md |"
          },
          {
            "sha256": "e720dffe48b97de0b2039c0c6c293364502e4186324cf7e2265db16075b78be1",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "only that these fields and bindings are mechanically acceptable."
          },
          {
            "sha256": "2bc526741ab3b502cb5157d4127f74d94cb48342ba492c8aece04b39d7779a51",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "is integer `1`. `reviewer` must match the assigned identity. For acceptance,"
          },
          {
            "sha256": "2f9a5cb0ea1ced039e9f6a4dd140c532e286a9a8ee27856d484babdb4ad845ae",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "`assessments` has exactly one entry for every required predicate:"
          },
          {
            "sha256": "c8e9784046bf4477d0c8cc6e1dfea9e72f12d7c9f63dced0645826292eae017c",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "This fragment illustrates shape only; it is not a review or a usable full receipt."
          },
          {
            "sha256": "294f00edb021ca62f2bb5c2a073c4e9f162b1e07844f3daa9b74753b47c9e3b2",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "and must be >=4; category means are reporting only. Supply means without display rounding"
          },
          {
            "sha256": "7ad1eb577ceb26c4709cb99fb62a021d40dbefa3e801fb5f48fbaceb83abacfd",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "local diagram pixel inspection, even for a JSON-only delivery request."
          },
          {
            "sha256": "4f5c3e2e5d768a4caf4b9dd090677a617395320124ae4c32b02fa30f97a93599",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "mandatory; the reviewer must assess whether evidence meets it. `evidence` and"
          },
          {
            "sha256": "87d0dc404801626db53988d0823db4984c49bdf380f4823919b9aa19b0df71c9",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "it never reconstructs acceptance by guessing from orphan objects. Preserve the"
          },
          {
            "sha256": "acd2858a663042cbee4ab01c68a198033cba0b3e52f48c2386e8d2c2778a80f1",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "Unreferenced interrupted writes are not authority and are never auto-promoted."
          },
          {
            "sha256": "fa540c4f039c0348f92022e5b33b29b90ea44f279c7301f2aad286803f44d462",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "checks G4 and saved-target evidence. G4-only readback drift must not revoke unchanged"
          },
          {
            "sha256": "be8d9502c8b91bfeb655284cc9fe2ab030ed9a0d0bd822f6901e67f52de71aad",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "until rebound. G2/G3-only rebinding is refused. G0 rebinding invalidates all current"
          },
          {
            "sha256": "4e4caf1a314c4cfdaca21d5c5721c9ae5e82127f5e8d6465d2a6b4a4086a3758",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "registers. Additions do not introduce a scoring rubric or external dispatcher."
          },
          {
            "sha256": "bdf559174a3776a35e25b43b40b625f35bb1940c7ff5d663bb791c7107a368a2",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "It cannot ground a technical claim. Never claim an opened range from a filename."
          },
          {
            "sha256": "07e2861be92fe52c1ec7f9f52ee4309cee91556db61b5db713ebecaefdb0ec88",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "\"walk_away_item\": \"Required behavior or observable outcome cannot be supported\","
          },
          {
            "sha256": "f8a2ef0f5a222fe2558d0c2a8ac4c3b523233a679ca3f9a0e6f093736dff69a6",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "calling only failed accept does not record the review for retry control."
          },
          {
            "sha256": "c49e0f154f82a895e2eb386aef4269ea7fc1350f301cd63ea9309b0a0342f27f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "Only new opened evidence in freshly accepted G2 enables a new attempt. Additional"
          },
          {
            "sha256": "02a913624547af8a3b785b911838d5abd28123110611a2d24cfb2013354c6286",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "Classify floor-only reviews only when the work-order policy hash equals the digest"
          },
          {
            "sha256": "23013faefa94c7d22e13411351ebe3b4b3d0f9f609c9165a3e54d5585910c263",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "predecessor to contain research-coverage.json. Do not rewrite accepted snapshots."
          },
          {
            "sha256": "674f91837e2f26d0a2693e86bdfdaea9033acaf1d95def265be8afa4730e990a",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "parsed JSON, not raw bytes; digest syntax and bindings do not authenticate a valid"
          },
          {
            "sha256": "1106aa2390b03ebecfaef08433b49186b3a8509b2d54db3de2c62734f733066e",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "Do not rebind automatically to evade a failed review; a hash change is not a new"
          },
          {
            "sha256": "e3df40fe4245c8e9154a7d87c45ffb11f2f8412a36fb5c264561ca4488a8201c",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "product fact. Older receipts do not become current passes or failures by migration."
          },
          {
            "sha256": "ad45f24e41df2b833f8f96085f503fd82bad4128d0e61e7bce89c6772a60d350",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "the writer will actually use, and every entry must be in accepted G2 coverage."
          },
          {
            "sha256": "1e2dbb18fe66fcd3aa562873afac96643e2896fc679c8ff0b76fe04eb4e31efc",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "After a sole-average failure, at least one assigned basis fact must be new. At"
          },
          {
            "sha256": "90941f14edeec54d7536e1b57654f9b99c4ee41366f9534c7147f13ccfa6006d",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "seal, each selected part ID must name a grounded claim; selected extension claims"
          },
          {
            "sha256": "fc9b01a18a668577c2ad2c6b31df4b26c63cba30680bbe53dc55b75fb94ba313",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "The selected set must actually use the new fact through its claim/basis closure."
          },
          {
            "sha256": "cbf70bba97a48f0bdc37e8f8db340591796b246249ddd77a82c8306222dabc95",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "arbitrary locator labels or reformatted equivalent ranges do not create a fact."
          },
          {
            "sha256": "c0fa270b4f37a223da3d5c6dffb868940cf6fa3be412881bbe4aa20225484396",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "obtains the required target permissions and emits local evidence."
          },
          {
            "sha256": "d303aa43b00f1a80f93ff05074624157b5b4f6f85490485843c148219ff4cfe4",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "already-created target and read it back before recording a result. Do not create"
          },
          {
            "sha256": "d604a2b6ccd3257f46927a01aad2008da997d0ecf2d39c55ae68d78c4ad6a786",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "and cannot be substituted with `structured`. JSON-only runs can reach G4 with these"
          },
          {
            "sha256": "d658ac4fb47d8dda85df66f7597cee8703775147e6e2598b938a6d7478000531",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "generic score audits do not bypass predicate or respondent route ownership."
          },
          {
            "sha256": "0d3d38c7960aa87b31124bcf0abeb2c05169908c1165fef1fbd53321dfa1bd1b",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/runtime.md",
            "text": "The generic contradiction must bind an actual score rationale and cited source"
          },
          {
            "sha256": "571b090d9f7b2ce5793e252823a736e502afba781f8bd0c2f345c93d1a5fbd8e",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "consistency only. A missing/corrupt journal produces `unverifiable`, zero verified"
          },
          {
            "sha256": "cf0745bfcefaa39211698f2df3e89558c79a9c3d1c5efeb606f1ac4579341388",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "opens its assigned candidate directory. Destination labels are plain text, never"
          },
          {
            "sha256": "e8f1b47f6bfb44ddc79dfcbc8e4f98d058e1d8aa368f166f80170fa4f461b6c1",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "The 900-second default is an adjustable observation freshness window, never a"
          },
          {
            "sha256": "be479775e2f20f0f649fc8ee28701041985e84926705249f06b4acd1d056db35",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "no assumed denominator. Counts measure verified gates only. Investment appetite"
          },
          {
            "sha256": "534b789434303f533a60372ccf8b334c9d40161e3b397754948187992b9704b8",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "The controller must supply real host observations including scope and limitations."
          },
          {
            "sha256": "cf3736caa355a3c5a781693b9117962877f74e69e8b11d8ada8d54d19b8754a7",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "evidence hash and committed version bind each record. Timestamps must be actual UTC,"
          },
          {
            "sha256": "3bdca50741850ed6e44c79717b939b83d96f21b4ff9f3151ae1451866cac6be1",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "reported separately and never becomes good merely because old evidence vanished."
          },
          {
            "sha256": "b143ed6aa8ec0991d60b477fd97dc13e0dfe0a4c5c83025f65cb76638b0987c8",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "observations only. Prepared/dispatched assignments are queued; only a fresh started"
          },
          {
            "sha256": "df87148d04a1d07ae756a53d9f261afa74e890a70171afd71954cf3481242e55",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "- `review_returned`: the evidence file must be a full runtime ReviewReceipt for"
          },
          {
            "sha256": "4cbf1fed7d2f696da74593cf13e59890d4bf2a4bbca93b4e0eb91c272025f235",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "receipts can be recorded but never accepted by this command. Conflicting"
          },
          {
            "sha256": "b17266375419dad2c4c47111cfb58200fcc1fdd6c7ba55b64861d7a8edcbef46",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "operation's saved record hash. `unchanged` must match the saved verified"
          },
          {
            "sha256": "2b3a1a8c880241c21e1ddeeed52f1a7e08d35246b6d66bdf42af65256f620e8b",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "revision; it means observed unchanged at that time, never unchanged now."
          },
          {
            "sha256": "625094465b8e096f1fb80d4d09a3bdd877a088847f8f42b482458ca9f8586d31",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "confirmed prerequisite holds, unanswered required decisions, sealed review pending,"
          },
          {
            "sha256": "f33b64842963a844ec7988b5562e1d7155b4b7a73a0e7d0fdf5e650728df4273",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "questions come only from a sealed register, never loose files. Holds show the"
          },
          {
            "sha256": "f3858340f44e90031467b573cd24240af4cebca601aed8a1da124019a5c152b2",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "request context, never independently from historical acceptance. Content and local"
          },
          {
            "sha256": "1ff1e926140756d5269765a488a5b9b73cd44259e52941409b967607207ed82e",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "`current.label` and its finish action announce completion only when"
          },
          {
            "sha256": "a6dfcf6df1ce3b55e8e63f1ac5034eacefe2cea2a1325e84d96ccedc65b070db",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "do not infer it from HTML generation. G3's local-diagram predicate does not prove"
          },
          {
            "sha256": "be859d49e4061ae5ff4d4509ceee467f62fd411a292783f10ed93c562228f84f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "recorded time. A negative target observation clears only through a later intact"
          },
          {
            "sha256": "d4fcc3689e63a7b8fa46e7d7ec6b993dde1b63f756cb9c8c9cfcbb763a84efde",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "version do not retroactively prove resolution. `observation_integrity` separately"
          },
          {
            "sha256": "9899009665cb202518a3c910593536e7c89b626fc22170437cfa9cdf8ffd4369",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "Target-only problems preserve unchanged G3 content. Source changes and target"
          },
          {
            "sha256": "c1bbd9b8303ed33fde206de87f699bdc05f727edef506002f6317a619aad5db3",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "HTML uses text-labelled stage indicators, not color-only progress or an effort"
          },
          {
            "sha256": "0cbb48051ec1aac3b9091b24d0834c3da300cfd035b8b2af316101cb235ecaf1",
            "source": "sources/capability-resources/engos-quality-shaping-gate/references/progress.md",
            "text": "transaction boundaries. They use simulated receipts; they do not establish"
          },
          {
            "sha256": "6ab03fed166714bdf652043f9f1f181ee74b8983e3c1572a69fbab6b6a66ed00",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"title\": \"Controller observations and read-only progress projection\","
          },
          {
            "sha256": "c7698dec2ae74624d0b2ceb970ae64e634488e16b2d7b3c6020fd47e3d1ff6db",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"description\": \"Select context, observation or projection. Runtime additionally checks versions, assignments, subject/evidence hashes, timestamps, current generations and safe paths. These records do not authenticate a human/host or grant acceptance.\","
          },
          {
            "sha256": "7c412d9e4598fab33cf14131da709345fd80536af522743aa993a3a6d762ea63",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"required\": [\"name\", \"evidence_mode\", \"requested_stop\", \"observed_at\", \"evidence\", \"investment_appetite\"],"
          },
          {
            "sha256": "97ce7e26f4c121c9c27e05ee5853c801c2ded07bfe41dc79498419d2694d7993",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"required\": [\"event_id\", \"run_id\", \"version\", \"generation\", \"work_order_id\", \"kind\", \"observed_at\", \"actor\", \"evidence\"],"
          },
          {
            "sha256": "b2b82195070914ca2e06ecb15c2182707ce30d366dbc86b0a390a3a57e0390a3",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"then\": {\"required\": [\"hold_type\", \"reason\", \"needed\", \"respondent\", \"next_action\"]},"
          },
          {
            "sha256": "4d2937aadb4e3cec30cf25937ee6dd632cdf6cbbd0574b4d14fea4228df8452f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"else\": {\"not\": {\"anyOf\": [{\"required\": [\"hold_type\"]}, {\"required\": [\"reason\"]}, {\"required\": [\"needed\"]}, {\"required\": [\"respondent\"]}, {\"required\": [\"next_action\"]}]}}},"
          },
          {
            "sha256": "1408e4e6c67f3ef7759baa9e52e8408aaa96f8d836190800fd55a4b1d9ea982f",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"then\": {\"required\": [\"resolves\"]}, \"else\": {\"not\": {\"required\": [\"resolves\"]}}},"
          },
          {
            "sha256": "187dfdfddb88cf68fd3cd3a52f998f4360c26d1d7a19f301e393b213b26b60cd",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"then\": {\"required\": [\"operation_id\", \"result\", \"target_revision\"]},"
          },
          {
            "sha256": "6ce48e1805b101a04f35f593657bc121a46e684c36c34110074007b9f5f7fedf",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"else\": {\"not\": {\"anyOf\": [{\"required\": [\"operation_id\"]}, {\"required\": [\"result\"]}, {\"required\": [\"target_revision\"]}]}}}"
          },
          {
            "sha256": "7d01ae5433e30ec7aa123fbc7ec4f2ed69ac638659fc9d17ff263c730ad56075",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"required\": [\"schema_version\", \"status\", \"snapshot_at\", \"gates\", \"verified_count\", \"applicable_count\", \"requested_complete\"],"
          },
          {
            "sha256": "ef3e8fa3495bf09211de23720e67d6c48fa47213d98677e90b2d69a9c3f9989b",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"type\": \"object\", \"required\": [\"gate\", \"state\"],"
          },
          {
            "sha256": "8718f72fd18b5986005db43e7aa78c60e75caafe8a7b61d1f987161bf9443a99",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"then\": {\"required\": [\"run_id\", \"name\", \"version\", \"generation\", \"revision\", \"evidence\", \"requested_stop\", \"current\", \"activity\", \"latest_accepted\", \"latest_draft\", \"targets\", \"local_integrity\", \"remote_freshness\", \"policy_drift\", \"observations\", \"invalid_observations\", \"warnings\", \"investment_appetite\", \"checkpoint_effort\", \"registers\", \"content_review\", \"visual_review\"]},"
          },
          {
            "sha256": "be5960f69b57a489274576f271edf182868a0e1a45f5d6eb782d4b6d99272b54",
            "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/progress.schema.json",
            "text": "\"else\": {\"required\": [\"reason\"], \"properties\": {\"verified_count\": {\"const\": 0}, \"requested_complete\": {\"const\": false}}}}]"
          },
          {
            "sha256": "729a49567457abef665e922e799f02d50cbaeafdb598a3521e7aaadaf703318b",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "\"\"\"Controller-operated shaping journal. Python 3.11+, standard library only."
          },
          {
            "sha256": "a47ef6e0efc577be784be508964458f474964a1a0317e54a3deccb558b4aef91",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "\"\"\"Only run-relative references; never turn destination labels into URLs.\"\"\""
          },
          {
            "sha256": "104d690baa6d657d78c7ff5d8f22c3ed86c1603d74a7f4d6ab0d01e8e895a525",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "\"\"\"Persistent state cannot be verified; do not guess success.\"\"\""
          },
          {
            "sha256": "4d7851843cb32082e89cd8dfd7c156ee4643c606ef2c7552dcc08dbf8397accb",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "def shape(value, required, optional=()):"
          },
          {
            "sha256": "fb4e290ea98ed09616c8394d012d5328aef24e5de95e86d1803f60bc990ac9da",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "require(set(required) <= value.keys(), f\"missing fields: {sorted(set(required) - value.keys())}\")"
          },
          {
            "sha256": "9eb06e38c76f4ac2753f49143d9715f9c52c1d2444fd4d352a67250f244ef897",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "require(value.keys() <= set(required) | set(optional), \"unknown fields\")"
          },
          {
            "sha256": "a53453a43c3d944ebd49cee2491d23ed668c86f3fe026362038b0417568a554a",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "require(match is not None, \"locator must use canonical N:M line-range form\")"
          },
          {
            "sha256": "80ca6a8493f3aaee26fee51819f67ec3630ad7ba0df0676128eb0562b4143fe6",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "raise Hold(\"opened source must be valid UTF-8\") from exc"
          },
          {
            "sha256": "66fd2c2301ac5789a6de71b421f2a4b5aeac3b42bb99d1d20ebacb1e592ef833",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "require(isinstance(policy[\"delivery_targets\"], list), \"targets must be an array\")"
          },
          {
            "sha256": "d017892b82a24f8cebc21c31a7ab8b29b1a60226ff4eb195cd0e4d62567a9ddf",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "Pixel variation is only a blank-image guard, never semantic visual judgment."
          },
          {
            "sha256": "1b563fae918eba6bb03c05f9fca643c8a817b2b67c319c65d69cc4907b8aaf2d",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "must first follow the existing exporter normalization path."
          },
          {
            "sha256": "cd0cc3fb028cb771425617a28835dc02c98d93d8b577bd624eb34eb1ec58fe0e",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "except UnicodeError as exc: raise Hold('SVG must be UTF-8') from exc"
          },
          {
            "sha256": "82e2eb9a66abcbd340fb15ecbfc31617a711ea2903f58a22fa5f53565b916e97",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "require(path.is_relative_to(self.root), \"policy must be under run root\")"
          },
          {
            "sha256": "42b9d3a7f9dc67c1de8f46398d009537152498d94d20540c4bb9d3fc6d32bf85",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "\"\"\"Append a host observation to the sole controller journal; never accept.\"\"\""
          },
          {
            "sha256": "c8bec80c7c2564e6e5f37bf0d0e66c4e98e4798137ed8f6016fe265e989b5adc",
            "source": "sources/capability-resources/engos-quality-shaping-gate/scripts/shaping_run.py",
            "text": "require(\"respondent\" in record, \"respondent required; null means unassigned\")"
          },
          {
