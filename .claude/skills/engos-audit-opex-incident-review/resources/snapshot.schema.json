{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-prompts.invalid/schemas/opex-digest-snapshot-v1.json",
  "title": "OpEx Digest Snapshot",
  "type": "object",
  "required": ["schema_version", "as_of", "scope", "coverage", "incidents", "dpas"],
  "properties": {
    "schema_version": {"const": "OpExDigestSnapshot.v1"},
    "as_of": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "required": ["label", "priorities"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "priorities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "jira_base_url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": ["status", "sources"],
      "properties": {
        "status": {"enum": ["complete", "partial", "blocked"]},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "generated_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "stuck_days": {"type": "integer", "minimum": 1},
        "chronic_days": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": false
    },
    "dpa_sla_days": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "summary", "group", "priority", "status", "owner", "created", "last_meaningful_progress"],
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$"},
          "summary": {"type": "string", "minLength": 1},
          "group": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "created": {"type": "string", "format": "date"},
          "last_meaningful_progress": {"type": "string", "format": "date"},
          "on_board": {"type": "boolean"},
          "new_classification": {"enum": ["new", "correction"]},
          "affected_entities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "why_open": {"type": "string"},
          "dpa_keys": {"type": "array", "items": {"type": "string"}},
          "unlinked_dpa_keys": {"type": "array", "items": {"type": "string"}},
          "postmortem": {
            "type": "object",
            "properties": {
              "required": {"type": "boolean"},
              "state": {"enum": ["missing", "blank", "filled", "written", "not_needed"]},
              "due": {"type": "string", "format": "date"},
              "complete": {"type": "boolean"},
              "signoff_complete": {"type": "boolean"},
              "evidence": {"type": "string"}
            },
            "additionalProperties": true
          },
          "deep_dive": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "dpas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "summary", "parent", "priority", "status", "created"],
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$"},
          "summary": {"type": "string", "minLength": 1},
          "parent": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$"},
          "priority": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "created": {"type": "string", "format": "date"},
          "due": {"type": "string", "format": "date"},
          "historical_parent": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "kind", "description", "current_status", "counts_as_progress"],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "group": {"type": "string"},
          "kind": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "current_status": {"type": "string", "minLength": 1},
          "counts_as_progress": {"type": "boolean"},
          "exclusion_reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "open": {"type": "integer", "minimum": 0},
          "dpas_overdue": {"type": "integer", "minimum": 0},
          "postmortems_overdue": {"type": "integer", "minimum": 0},
          "chronic": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "resolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "evidence"],
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$"},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "additional_decisions": {"type": "array", "items": {"type": "object"}},
    "additional_patterns": {"type": "array", "items": {"type": "string"}},
    "caveats": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
