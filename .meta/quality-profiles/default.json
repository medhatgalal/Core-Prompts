{
  "profile": "default",
  "display_name": "Default Quality Profile",
  "description": "Generic UAC quality profile for reusable skill or agent uplifts.",
  "judge_targets": {
    "operational_richness": 9,
    "source_fidelity": 9,
    "metadata_integrity": 9,
    "benchmark_readiness": 9
  },
  "max_passes": 10,
  "local_benchmarks": [
    "ssot/engos-design-architecture.md",
    "ssot/engos-quality-code-review.md",
    "ssot/engos-quality-testing-review.md",
    "ssot/engos-meta-uac-import.md",
    "ssot/engos-delivery-resolve-conflict.md"
  ],
  "must_exceed": [
    "architecture operational bar",
    "code-review operational bar",
    "testing explicit-output bar",
    "uac-import metadata and workflow bar",
    "original source substance when present"
  ],
  "prohibited_regressions": [
    "thin summary replacing operational procedure",
    "metadata replacing prompt-body richness",
    "orchestration leakage",
    "surface claims unsupported by the capability body"
  ],
  "required_markers": {
    "operational_richness": [
      "## Purpose",
      "## Primary Objective",
      "## Workflow",
      "## Rules",
      "## Required Output",
      "## Constraints",
      "## Examples",
      "## Evaluation Rubric"
    ],
    "source_fidelity": [
      "Primary Objective",
      "Examples",
      "Constraints",
      "Required Output"
    ],
    "metadata_integrity": [
      "advisory",
      "do not",
      "descriptor"
    ]
  },
  "consumption_hints": {
    "preferred_use_cases": [
      "AI-assisted capability selection",
      "deterministic prompt uplift review"
    ],
    "artifact_conventions": [
      "ssot/<slug>.md",
      ".meta/capabilities/<slug>.json",
      "reports/quality-reviews/<slug>/LATEST.md"
    ],
    "invocation_style": "assistant_first_but_scriptable",
    "requires_human_confirmation": true
  },
  "minimum_word_count": 180,
  "minimum_code_blocks": 0,
  "assessment_contract": {
    "score_scope": "mechanical_structure_only_not_semantic_or_behavioral_proof",
    "semantic_findings": "require explicit review or source-grounded repair; never clear through keyword counts",
    "repair_mode": "normalize equivalent headings only; no generic operating stubs",
    "convergence": "stop on resolved checks, unchanged candidate, repeated candidate, or pass limit; report unresolved findings",
    "preservation": "exact by default; optional independent requirement review bound to original, candidate, and effective package hashes; no behavioral promotion"
  },
  "heading_aliases": {
    "## Required Output": [
      "## Output Contract",
      "## Expected Output",
      "## Expected Outputs"
    ],
    "## Required Inputs": [
      "## Inputs"
    ],
    "## Evaluation Rubric": [
      "## Acceptance Criteria"
    ]
  }
}
