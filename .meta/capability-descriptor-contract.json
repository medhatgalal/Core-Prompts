{
  "schema_version": "CapabilityDescriptorContract.v1",
  "routing_fitness_contract": {
    "schema_version": "RoutingFitness.v1",
    "location": "job_contract.routing_fitness",
    "required_fields": [
      "schema_version",
      "mapping_status",
      "task_phases",
      "activation",
      "risk_authority_ceiling",
      "negative_examples",
      "conditional_companions",
      "pack_hints",
      "provenance",
      "unresolved_fields"
    ],
    "advisory_only": true,
    "behavioral_claim": "none",
    "legacy_policy": "accept missing fitness; never imply reviewed or behavioral readiness"
  },
  "required_top_level": [
    "benchmark_sources",
    "consumption_hints",
    "declared_capability",
    "descriptor_version",
    "display_name",
    "expected_surface_names",
    "family_slug",
    "historical_baseline",
    "inferred_capability",
    "job_contract",
    "layers",
    "manifest_version",
    "modes",
    "quality_validation_matrix",
    "rubric_version",
    "shared_constraints",
    "shared_summary",
    "slug"
  ],
  "required_layers": {
    "minimal": [
      "capability_type",
      "confidence",
      "display_name",
      "domain_tags",
      "emitted_surfaces",
      "expected_outputs",
      "install_target",
      "packaging_profile",
      "rationale",
      "required_inputs",
      "resources",
      "review_status",
      "role",
      "source_provenance",
      "summary",
      "tool_policy"
    ],
    "expanded": [
      "adjustment_recommendations",
      "capability_dependencies",
      "migration_notes",
      "overlap_candidates",
      "relationship_suggestions"
    ],
    "org_graph": [
      "authority_tier",
      "collaborates_with_suggestions",
      "delegates_to_suggestions",
      "org_role",
      "reports_to_suggestions",
      "work_graph_impact"
    ]
  },
  "required_mode_fields": [
    "mode_slug",
    "display_name",
    "entry_kind",
    "invocations",
    "source_refs"
  ],
  "required_job_contract_fields": [
    "primary_job",
    "use_when",
    "works_on",
    "main_output",
    "not_for",
    "authority",
    "routing_question",
    "nearest_neighbors",
    "shape",
    "portfolio_action"
  ],
  "forbidden_quality_statuses": [
    "ship"
  ],
  "skill_job_map_evidence_contract": {
    "location": ".meta/skill-job-map.json availability",
    "advisory_only": true,
    "source_binding": "SSOT path and content SHA-256; run reports bind commit/candidate",
    "generated_package_binding": "not_inspected with distribution paths and manifest reference",
    "runtime_policy": "release, installed bytes, native discovery and scoped runtime evidence require per-run/initiative reports; never inferred from curation or source presence",
    "legacy_policy": "v1/v2 maps without availability remain accepted without implying evidence",
    "neighbor_handoff": "optional curated condition and nonempty portable source path/line/hash references; generation rejects missing, escaped or stale references; nearest_neighbors and portfolio_action retain advisory meaning"
  }
}
