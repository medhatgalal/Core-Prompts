    },
    {
      "sha256": "061a527ee06de0baad773d4ea25caad3ffa470b592f887c0143a29b11affb783",
      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
      "text": "\"oneOf\": [{\"required\": [\"pixels\"], \"not\": {\"required\": [\"structured\"]}}, {\"required\": [\"structured\"], \"not\": {\"required\": [\"pixels\"]}}],"
    },
    {
      "sha256": "29f84561162adab7debb150fc0a0315042f9b27b4d0a76e387f080a55e8f0c2f",
      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
      "text": "\"required\": [\"schema_version\", \"run_id\", \"gate\", \"work_order_id\", \"generation\", \"policy_hash\", \"resource_revision\", \"predecessor\", \"return_hash\", \"subject\", \"reviewer\", \"authored_candidate\", \"independence_confirmed\", \"evidence\", \"assessments\", \"findings\", \"unresolved_blockers\", \"verdict\", \"next_state\", \"scores\", \"render_evidence\", \"targets\"],"
    },
    {
      "sha256": "59965fc9ea6ad7868c392af7dc38c2301915d14469bcf8890fa17917100651b7",
      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
      "text": "\"then\": {\"properties\": {\"scores\": {\"$ref\": \"#/definitions/scores\"}, \"render_evidence\": {\"required\": [\"component.mmd\", \"sequence.mmd\", \"data-flow.mmd\"]}}},"
    },
    {
      "sha256": "2866078e8b9241a31657fbe3358814f579e16b929f6ccc39dfa5b97c91cde2ab",
      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
      "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"status\", \"note\"],"
    },
