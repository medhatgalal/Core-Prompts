      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
      "text": "\"description\": \"Acceptance requires pass for every policy predicate. This is an actual reviewer assessment, never author keyword scoring.\""
    },
    {
      "sha256": "42fc2d896ab16d57c9ee852567491730604d341eaa124ad6eed54246afe48b6c",
      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
      "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"score\", \"rationale\", \"evidence_ids\"],"
    },
    {
      "sha256": "7967581eafbb49f7e30743e7f82b267e44b704ca704a67709600a30f366269ef",
      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
      "text": "\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"dimensions\", \"team_mean\", \"pitch_mean\", \"overall\"],"
    },
    {
      "sha256": "fc34566e227a9dfcc4c95f76825909e2c992b885ac6149dd7cf4f66e3a51ef6f",
      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
      "text": "\"required\": [\"simplicity\", \"testability\", \"security\", \"architecture\", \"cost\", \"feasibility\", \"confidence\", \"problem_clarity\", \"appetite_fit\", \"solution_sharpness\", \"contract_quality\", \"boundary_discipline\"],"
    },
    {
      "sha256": "21698734d1077d84703ec86790217a8349fcba0eaf0feb49ef3af564ab085658",
      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
      "text": "\"description\": \"All twelve scores >=3; overall >=4. Overall=sum(all twelve scores)/12, checked to absolute tolerance 1e-9. Category means are reporting only. Use source-specific rubric anchors; no generic all-5 implementation rule.\""
    },
    {
      "sha256": "b7a8364270c42ee7e98f9d0030b7a2769ed279d419637620d7d6c06561b303e4",
      "source": "sources/capability-resources/engos-quality-shaping-gate/schemas/runtime.schema.json",
