    {
      "sha256": "fc06d7da0e887d842488bc7b2d9565ad9f201a4c604418c5ddcafabdb47d8b52",
      "source": "ssot/engos-debug-diagnose-failure.md",
      "text": "Use read-only history/diff analysis to narrow regression candidates. Do not run mutating"
