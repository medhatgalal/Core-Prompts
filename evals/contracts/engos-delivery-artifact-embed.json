    {
      "sha256": "a962c6cdb57b116e72ed4d5383a7a7274333cdd79c129c997f751dd232bdc444",
      "source": "ssot/engos-delivery-artifact-embed.md",
      "text": "| Google Doc | Rendered PNG embedded through verified private DOCX conversion | Native Docs tables plus source link/hash | Render, upload through the supported path, insert, then read back; never rely on a public URL assumption |"
    },
    {
      "sha256": "45cbde27ffa75f570dd46c117d0e36bfd86b19cfe1ed7dec08b615be04cdcac0",
      "source": "ssot/engos-delivery-artifact-embed.md",
      "text": "4. For Google Docs, render Mermaid to an image only at the adapter boundary."
    },
    {
      "sha256": "8ab98e316c4e881b80ec86b4ef919d68d234111cf32c3adc3500bb24df02f7c3",
      "source": "ssot/engos-delivery-artifact-embed.md",
      "text": "ledger. Never silently downgrade a failed image placement to an untracked"
