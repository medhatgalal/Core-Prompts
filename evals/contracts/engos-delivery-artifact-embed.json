    {
      "sha256": "a88db5cd38abbf7b5155442404fb2bfc7019a7f23e457f00141b30ee36277a1e",
      "source": "ssot/engos-delivery-artifact-embed.md",
      "text": "bundle, not only diagrams. This section refines the artifact-only workflow above:"
