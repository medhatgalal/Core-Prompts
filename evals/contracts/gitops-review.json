    {
      "sha256": "ae1fc668c8f5bfe6e5e90ffe74cfcff66769ebbc7681481500d2fb9c8546b19e",
      "source": "ssot/gitops-review.md",
      "text": "- Do not merge, tag, package, or release without stating the prerequisite checks."
