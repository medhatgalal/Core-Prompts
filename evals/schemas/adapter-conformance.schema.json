{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AdapterConformance.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "conformance_id", "issuer", "adapter_id", "adapter_version",
    "adapter_sha256", "cli_version", "cli_sha256", "cell_id", "host",
    "resolved_model_identifier", "model_version", "effort", "tool_policy_sha256",
    "approval_policy_sha256", "credential_descriptor_sha256", "authentication_verified",
    "response_model_resolved", "usage_complete",
    "retry_semantics_verified", "tool_semantics_verified", "session_isolation_verified",
    "authorship_boundary_verified", "fixture_receipt_sha256s", "probe_receipt_sha256s",
    "qualified", "created_at", "expires_at", "signature"
  ],
  "properties": {
    "schema_version": {"const": "AdapterConformance.v1"},
    "conformance_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "adapter_sha256": {"$ref": "#/$defs/sha256"},
    "cli_version": {"type": "string", "minLength": 1},
    "cli_sha256": {"$ref": "#/$defs/sha256"},
    "cell_id": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "resolved_model_identifier": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "effort": {"type": "string", "minLength": 1},
    "tool_policy_sha256": {"$ref": "#/$defs/sha256"},
    "approval_policy_sha256": {"$ref": "#/$defs/sha256"},
    "credential_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "authentication_verified": {"const": true},
    "response_model_resolved": {"const": true},
    "usage_complete": {"const": true},
    "retry_semantics_verified": {"const": true},
    "tool_semantics_verified": {"const": true},
    "session_isolation_verified": {"const": true},
    "authorship_boundary_verified": {"const": true},
    "fixture_receipt_sha256s": {"$ref": "#/$defs/hashList"},
    "probe_receipt_sha256s": {"$ref": "#/$defs/hashList"},
    "qualified": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "purpose", "signed_at", "payload_sha256", "value_base64"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "purpose": {"const": "adapter_conformance"},
        "signed_at": {"type": "string", "format": "date-time"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "value_base64": {"type": "string", "minLength": 1}
      }
    }
  }
}
