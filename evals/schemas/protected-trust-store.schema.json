{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProtectedTrustStore.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "ProtectedTrustStore.v1"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/root"}
    }
  },
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "key_id", "algorithm", "public_key_base64", "purposes",
        "not_before", "expires_at", "revoked_at"
      ],
      "properties": {
        "schema_version": {"const": "ProtectedTrustRoot.v1"},
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "public_key_base64": {"type": "string", "minLength": 1},
        "purposes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "adapter_conformance", "execution_receipt", "global_token_ledger", "judge_qualification",
              "promotion_verdict", "sealed_bundle"
            ]
          }
        },
        "not_before": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
