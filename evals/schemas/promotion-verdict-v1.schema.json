{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PromotionVerdict.v1",
  "type": "object",
  "required": [
    "schema_version", "run_id", "slug", "status", "baseline_sha256", "candidate_sha256",
    "goal_contract_sha256", "topology_sha256", "dataset_sha256", "scorer_sha256",
    "evaluator_version", "profile", "token_cap", "required_cells", "hard_gates",
    "token_usage", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "PromotionVerdict.v1"},
    "status": {"enum": ["structural_ready", "behavioral_pending", "promote", "hold", "blocked_contract", "inconclusive", "rollback", "stale_evidence"]},
    "profile": {"enum": ["static", "native", "routing-canary", "canary", "promotion", "cross-host", "sweep"]}
  }
}
