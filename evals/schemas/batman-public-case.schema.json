{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BatmanPublicCase.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "goal", "fixture", "risk", "clause_ids", "checks"],
  "properties": {
    "id": {"type": "string", "pattern": "^BAT-PUB-[0-9]{3}$"},
    "goal": {"type": "string", "minLength": 1},
    "fixture": {"type": "string", "pattern": "^evals/fixtures/batman/.+\\.json$"},
    "risk": {"enum": ["critical", "high", "standard"]},
    "clause_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^batman:L[0-9]+:[0-9a-f]{12}$"}},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "op", "path", "value"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "op": {"enum": ["equals", "truthy", "contains", "excludes", "ordered_contains", "min_count", "max_count"]},
          "path": {"type": "string", "minLength": 1},
          "value": {},
          "critical": {"type": "boolean"}
        }
      }
    }
  }
}
