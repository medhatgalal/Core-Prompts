{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "task",
    "repository",
    "base",
    "head",
    "candidate_ref",
    "spec_sha256",
    "plan_sha256",
    "producer",
    "verifier",
    "collector_exit_code",
    "collection_result_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "ReviewPackageExpectation.v1"
    },
    "scope": {
      "const": "current_committed_candidate"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "generation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "object_format",
        "local_identity_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "local_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "base": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "head": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^(?:HEAD|refs/heads/.+)$"
    },
    "spec_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "script_sha256",
        "schema_sha256",
        "resource_map_sha256"
      ],
      "properties": {
        "owner": {
          "const": "engos-quality-code-review"
        },
        "script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resource_map_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_sha256",
        "expectation_schema_sha256"
      ],
      "properties": {
        "script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectation_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "collector_exit_code": {
      "type": "integer",
      "const": 0
    },
    "collection_result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPackageExpectation.v1"
}
